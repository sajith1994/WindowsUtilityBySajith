<Window x:Class="WindowsUtility.Dialogs.DiskCloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone, back up and restore"
        Width="1000"
        Height="800"
        MinWidth="760"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Clone, back up and restore" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Copy a whole disk to a new SSD, copy one partition, or back up Windows to an image file on another partition, an external disk or a network share, to restore later to a new SSD or to copy files out of. Partitions in use are copied from a Windows snapshot while Windows runs. The disk copied from is only read." />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh disks" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" VerticalAlignment="Top" Click="RefreshButton_Click" />
        </Grid>

        <TabControl Grid.Row="1" x:Name="ModeTabs">
            <!-- Whole disk -->
            <TabItem Header="Clone a whole disk">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Copy from" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="SourceDiskComboBox" DisplayMemberPath="DisplayText" SelectionChanged="CloneSelection_Changed" />
                        <TextBlock Grid.Column="3" Text="Copy to (erased)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="4" x:Name="TargetDiskComboBox" DisplayMemberPath="DisplayText" SelectionChanged="CloneSelection_Changed" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="PlanProblemsText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                            <Button x:Name="DecryptButton" Content="Decrypt" Tag="&#xE785;" Style="{StaticResource IconCompactButton}" HorizontalAlignment="Left" Margin="0,6,0,2" Visibility="Collapsed" Click="DecryptButton_Click" />
                            <TextBlock x:Name="PlanNotesText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserResizeRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="*" />
                                <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="100" />
                                <DataGridTextColumn Header="Now" Binding="{Binding Now}" Width="90" />
                                <DataGridTextColumn Header="On the new disk" Binding="{Binding Planned}" Width="130" />
                                <DataGridTextColumn Header="How it is copied" Binding="{Binding How}" Width="230" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <WrapPanel>
                            <CheckBox x:Name="UsedOnlyCheck" Content="Copy only the used space (much faster)" IsChecked="True" Margin="0,0,20,6" Checked="CloneOption_Changed" Unchecked="CloneOption_Changed" />
                            <CheckBox x:Name="BootableCheck" Content="Make the new disk start Windows" IsChecked="True" Margin="0,0,20,6" />
                            <CheckBox x:Name="VerifyCheck" Content="Check the copy afterwards" IsChecked="True" Margin="0,0,20,6" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="ConfirmPromptText" Text="To start, type the number of the disk that will be erased:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="ConfirmDiskBox" Width="60" Height="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="ConfirmDiskBox_TextChanged" />
                            <Button x:Name="StartCloneButton" Content="Start clone" Tag="&#xE8C8;" Style="{StaticResource IconPrimaryButton}" Margin="14,0,0,0" MinHeight="34" IsEnabled="False" Click="StartCloneButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- One partition -->
            <TabItem Header="Copy one partition">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,8,0">
                    <TextBlock Text="Partition to copy" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="PartitionSourceComboBox" DisplayMemberPath="DisplayText" SelectionChanged="PartitionSelection_Changed" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Copy to disk" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="PartitionTargetDiskComboBox" DisplayMemberPath="DisplayText" SelectionChanged="PartitionTargetDisk_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Where on that disk" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="PartitionSpaceComboBox" DisplayMemberPath="DisplayText" SelectionChanged="PartitionSelection_Changed" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox x:Name="FillSpaceCheck" Content="Use all of that space (the copy is extended to fill it, NTFS only)" Margin="0,0,24,6" Checked="PartitionSelection_Changed" Unchecked="PartitionSelection_Changed" />
                        <TextBlock Text="Drive letter" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <ComboBox x:Name="LetterComboBox" Width="150" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="PartitionPlanText" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button x:Name="PartitionDecryptButton" Content="Decrypt" Tag="&#xE785;" Style="{StaticResource IconCompactButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="DecryptButton_Click" />
                    <Button x:Name="StartPartitionButton" Content="Copy partition" Tag="&#xE8C8;" Style="{StaticResource IconPrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" MinHeight="34" IsEnabled="False" Click="StartPartitionButton_Click" />

                    <!-- After copying the EFI and Windows partitions one by one. -->
                    <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Make a disk start Windows" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,10"
                                       Text="After copying the EFI system partition and the Windows partition to a new disk one by one: writes the boot files to that disk and makes the copied Windows start as C:. (A whole-disk clone does this by itself.)" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Disk" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="BootDiskComboBox" DisplayMemberPath="DisplayText" SelectionChanged="BootDisk_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Its Windows partition" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="BootWindowsComboBox" DisplayMemberPath="DisplayText" SelectionChanged="BootSelection_Changed" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BootPlanText" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <Button x:Name="MakeBootableButton" Content="Make this disk start Windows" Tag="&#xE7E8;" Style="{StaticResource IconCompactButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="MakeBootableButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Backup to an image file -->
            <TabItem Header="Back up Windows">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,8,0">
                    <TextBlock Text="Disk to back up" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="BackupDiskComboBox" DisplayMemberPath="DisplayText" SelectionChanged="BackupDisk_Changed" />
                    <TextBlock Text="Partitions" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ItemsControl x:Name="BackupPartitionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,6" Checked="BackupSelection_Changed" Unchecked="BackupSelection_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Save the backup in" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupFolderBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="BackupFolder_Changed" />
                        <Button Grid.Column="1" x:Name="BrowseBackupFolderButton" Content="Browse..." Tag="&#xE8B7;" Style="{StaticResource IconCompactButton}" Margin="8,0,0,0" Click="BrowseBackupFolderButton_Click" />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="A folder on another partition, an external disk, or a network share such as \\nas\backups\this-pc. The backup is one .vhdx image (only the used space takes room) plus a small .backup.json description; keep the two files together." />
                    <Grid x:Name="SharePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="User name for the share (if it asks for one)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="BackupUserBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <PasswordBox x:Name="BackupPasswordBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="VerifyBackupCheck" Content="Check the backup afterwards" IsChecked="True" Margin="0,12,0,0" />
                    <TextBlock x:Name="BackupPlanText" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button x:Name="BackupDecryptButton" Content="Decrypt" Tag="&#xE785;" Style="{StaticResource IconCompactButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="DecryptButton_Click" />
                    <Button x:Name="StartBackupButton" Content="Start backup" Tag="&#xE8C8;" Style="{StaticResource IconPrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,8" MinHeight="34" IsEnabled="False" Click="StartBackupButton_Click" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Restore from an image file -->
            <TabItem Header="Restore a backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,8,0">
                    <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="RestoreFileBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="RestoreFile_Changed" />
                        <Button Grid.Column="1" x:Name="BrowseRestoreFileButton" Content="Browse..." Tag="&#xE8E5;" Style="{StaticResource IconCompactButton}" Margin="8,0,0,0" Click="BrowseRestoreFileButton_Click" />
                    </Grid>
                    <TextBlock x:Name="RestoreSummaryText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Choose a .vhdx backup made by this program; its .backup.json must be next to it." />

                    <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Restore to a disk" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="The whole backup goes onto the disk, which is erased first; when the backup holds Windows, the disk is made to start it. This is how a PC is recovered to a new SSD: connect the SSD (a second slot, or a USB enclosure), restore, then start from it." />
                            <TextBlock Text="Disk (erased)" FontWeight="SemiBold" Margin="0,10,0,6" />
                            <ComboBox x:Name="RestoreTargetComboBox" DisplayMemberPath="DisplayText" SelectionChanged="RestoreSelection_Changed" />
                            <TextBlock x:Name="RestorePlanText" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="RestoreBootableCheck" Content="Make the disk start Windows" IsChecked="True" Margin="0,0,20,6" />
                                <CheckBox x:Name="RestoreVerifyCheck" Content="Check the copy afterwards" IsChecked="True" Margin="0,0,20,6" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="RestoreConfirmPromptText" Text="To start, type the number of the disk that will be erased:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="RestoreConfirmBox" Width="60" Height="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="ConfirmDiskBox_TextChanged" />
                                <Button x:Name="StartRestoreButton" Content="Restore to disk" Tag="&#xE8C8;" Style="{StaticResource IconPrimaryButton}" Margin="14,0,0,0" MinHeight="34" IsEnabled="False" Click="StartRestoreButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,14,0,8">
                        <StackPanel>
                            <TextBlock Text="Copy files out of the backup" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Opens the backup as a disk in Explorer, so single folders or files can be copied back. Close it when done. A backup on a network share may have to be copied to this PC first; Windows refuses to open some from there." />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="OpenBackupButton" Content="Open backup" Tag="&#xE8DA;" Style="{StaticResource IconCompactButton}" Margin="0,0,10,0" IsEnabled="False" Click="OpenBackupButton_Click" />
                                <Button x:Name="CloseBackupButton" Content="Close backup" Tag="&#xE711;" Style="{StaticResource IconCompactButton}" IsEnabled="False" Click="CloseBackupButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Scheduled backups, run by the background service -->
            <TabItem Header="Automatic backups">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Backups the background service runs by itself: a system image of a disk, or a copy of one folder (newer files only; nothing is deleted at the destination). Every day, every week on chosen days, or every month on a date, at a time. A backup missed while the PC was off runs when it is on again." />
                        <WrapPanel>
                            <Button x:Name="AddImageScheduleButton" Content="Add system image backup" Tag="&#xE710;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="AddImageScheduleButton_Click" />
                            <Button x:Name="AddFolderScheduleButton" Content="Add folder backup" Tag="&#xE8B7;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="AddFolderScheduleButton_Click" />
                            <Button x:Name="EditScheduleButton" Content="Edit" Tag="&#xE70F;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" IsEnabled="False" Click="EditScheduleButton_Click" />
                            <Button x:Name="ToggleScheduleButton" Content="Turn off" Tag="&#xE7E8;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" IsEnabled="False" Click="ToggleScheduleButton_Click" />
                            <Button x:Name="RunScheduleButton" Content="Run now" Tag="&#xE768;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" IsEnabled="False" Click="RunScheduleButton_Click" />
                            <Button x:Name="RemoveScheduleButton" Content="Remove" Tag="&#xE74D;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" IsEnabled="False" Click="RemoveScheduleButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="SchedulesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserResizeRows="False" SelectionMode="Single" Margin="0,4,0,0" SelectionChanged="SchedulesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="What" Binding="{Binding What}" Width="*" />
                            <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="*" />
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="170" />
                            <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="*" />
                            <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" x:Name="ScheduleEditor" Visibility="Collapsed" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ScheduleEditorTitle" Text="New system image backup" FontSize="14" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox x:Name="ScheduleNameBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" x:Name="ScheduleImagePanel">
                                    <TextBlock Text="Disk to back up (all its partitions)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ScheduleDiskComboBox" DisplayMemberPath="Text" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" x:Name="ScheduleFolderPanel" Visibility="Collapsed">
                                    <TextBlock Text="Folder to back up" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScheduleSourceBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Browse..." Tag="&#xE8B7;" Style="{StaticResource IconCompactButton}" Margin="8,0,0,0" Click="BrowseScheduleSourceButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Save the backup in" FontWeight="SemiBold" Margin="0,10,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ScheduleDestinationBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="ScheduleDestination_Changed" />
                                <Button Grid.Column="1" Content="Browse..." Tag="&#xE8B7;" Style="{StaticResource IconCompactButton}" Margin="8,0,0,0" Click="BrowseScheduleDestinationButton_Click" />
                            </Grid>
                            <Grid x:Name="ScheduleSharePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="User name for the share (if it asks for one)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox x:Name="ScheduleUserBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password (kept encrypted on this PC)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="SchedulePasswordBox" Height="32" Padding="6,2" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,16,6">
                                    <TextBlock Text="How often" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ScheduleFrequencyComboBox" Width="150" SelectionChanged="ScheduleFrequency_Changed">
                                        <ComboBoxItem Content="Every day" />
                                        <ComboBoxItem Content="Every week" />
                                        <ComboBoxItem Content="Every month" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <TextBlock Text="At" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ScheduleHourComboBox" Width="70" />
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                        <ComboBox x:Name="ScheduleMinuteComboBox" Width="70" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ScheduleMonthDayPanel" Margin="0,0,16,6" Visibility="Collapsed">
                                    <TextBlock Text="On day" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ScheduleMonthDayComboBox" Width="70" />
                                </StackPanel>
                                <StackPanel x:Name="ScheduleKeepPanel" Margin="0,0,16,6">
                                    <TextBlock Text="Backups to keep" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ScheduleKeepComboBox" Width="70" />
                                </StackPanel>
                            </WrapPanel>
                            <ItemsControl x:Name="ScheduleWeekDaysList" Visibility="Collapsed" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,14,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ScheduleEditorNote" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="The service runs it with administrator rights, so nobody needs to be signed in. A system image keeps only the newest backups; a folder copy adds newer files to the same destination folder." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveScheduleButton" Content="Save" Tag="&#xE74E;" Style="{StaticResource IconPrimaryButton}" MinHeight="34" Click="SaveScheduleButton_Click" />
                                <Button Content="Cancel" Tag="&#xE711;" Style="{StaticResource IconCompactButton}" Margin="10,0,0,0" Click="CancelScheduleButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Progress -->
        <Border Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StageText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Tag="&#xE711;" Style="{StaticResource IconCompactButton}" Click="CancelButton_Click" />
                </Grid>
                <ProgressBar x:Name="CopyProgress" Height="8" Maximum="1" Margin="0,8,0,0" />
                <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
                <TextBox x:Name="LogBox" IsReadOnly="True" Height="110" Margin="0,8,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLine" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Tip: do the first clone with a spare disk, and keep the old disk until the new one starts Windows." />
            <Button Grid.Column="1" x:Name="CloseButton" Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100" MinHeight="36" Click="CloseButton_Click" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
