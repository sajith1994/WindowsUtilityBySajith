<Window x:Class="WindowsUtility.Dialogs.ThermalLoadTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsUtility.Controls"
        Title="CPU &amp; GPU Thermal Load Test"
        Width="1240"
        Height="860"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="StepNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style x:Key="ChoiceRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, safety summary and the live state badge -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="CPU &amp; GPU thermal load test" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="A short, supervised heat load while watching real sensors - a practical check that the coolers hold the temperature, not hardware certification. The test stops itself at your temperature limits, when sensor telemetry disappears, when time is up, or when this window closes."
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,24,0" />
            </StackPanel>
            <Border x:Name="StateBadge" Grid.Column="2" CornerRadius="16" Padding="14,6" VerticalAlignment="Top" Background="{DynamicResource SecondarySurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StateText" Text="Ready" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: set-up -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="Choose the load" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>

                            <TextBlock Text="Load target" Style="{StaticResource InfoLabelStyle}" />
                            <Border Style="{StaticResource ChoiceRow}">
                                <StackPanel x:Name="ModeChoices" Orientation="Horizontal">
                                    <RadioButton Content="CPU" Tag="Cpu" GroupName="ThermalMode" IsChecked="True" Style="{StaticResource SegmentedRadioButton}" Checked="ModeChoice_Checked" />
                                    <RadioButton Content="GPU" Tag="Gpu" GroupName="ThermalMode" Style="{StaticResource SegmentedRadioButton}" Checked="ModeChoice_Checked" />
                                    <RadioButton Content="CPU + GPU" Tag="Combined" GroupName="ThermalMode" Style="{StaticResource SegmentedRadioButton}" Checked="ModeChoice_Checked" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="GPU adapter" Style="{StaticResource InfoLabelStyle}" />
                            <ComboBox x:Name="GpuAdapterComboBox" Margin="0,6,0,4" FontSize="11" />
                            <TextBlock x:Name="GpuLoadModeText" Text="Checking GPU load method..." Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,10" />

                            <TextBlock Text="Load level" Style="{StaticResource InfoLabelStyle}" />
                            <Border Style="{StaticResource ChoiceRow}">
                                <StackPanel x:Name="LoadChoices" Orientation="Horizontal">
                                    <RadioButton Content="50%" Tag="50" GroupName="ThermalLoad" Style="{StaticResource SegmentedRadioButton}" />
                                    <RadioButton Content="75%" Tag="75" GroupName="ThermalLoad" Style="{StaticResource SegmentedRadioButton}" />
                                    <RadioButton Content="100%" Tag="100" GroupName="ThermalLoad" IsChecked="True" Style="{StaticResource SegmentedRadioButton}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Duration" Style="{StaticResource InfoLabelStyle}" />
                            <Border Style="{StaticResource ChoiceRow}" Margin="0,6,0,0">
                                <StackPanel x:Name="DurationChoices" Orientation="Horizontal">
                                    <RadioButton Content="30 s" Tag="30" GroupName="ThermalDuration" Style="{StaticResource SegmentedRadioButton}" />
                                    <RadioButton Content="1 min" Tag="60" GroupName="ThermalDuration" IsChecked="True" Style="{StaticResource SegmentedRadioButton}" />
                                    <RadioButton Content="2 min" Tag="120" GroupName="ThermalDuration" Style="{StaticResource SegmentedRadioButton}" />
                                    <RadioButton Content="5 min" Tag="300" GroupName="ThermalDuration" Style="{StaticResource SegmentedRadioButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="Safety stop limits" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CpuLimitLabel" Text="CPU stop temperature" Style="{StaticResource InfoLabelStyle}" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}">
                                    <TextBlock x:Name="CpuLimitValueText" Text="105 °C" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                            </Grid>
                            <Slider x:Name="CpuLimitSlider" Minimum="70" Maximum="105" Value="105" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,12"
                                    ToolTip="105 °C may be at or above the CPU's thermal-throttling point. Keep the test supervised."
                                    ValueChanged="TemperatureLimitSlider_ValueChanged" />

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GpuLimitLabel" Text="GPU stop temperature" Style="{StaticResource InfoLabelStyle}" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}">
                                    <TextBlock x:Name="GpuLimitValueText" Text="90 °C" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                            </Grid>
                            <Slider x:Name="GpuLimitSlider" Minimum="65" Maximum="105" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,8"
                                    ValueChanged="TemperatureLimitSlider_ValueChanged" />
                            <TextBlock Text="The limits are drawn as red dashed lines on the graph. The test also stops if a required temperature sensor stops reporting."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="GPU render preview" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="RenderingTierText" Text="Checking..." Style="{StaticResource CardDescriptionStyle}" Margin="0,2,0,8" />
                            <Border Height="150" Background="#FF080B12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Viewport3D x:Name="GpuLoadViewport" />
                                    <StackPanel x:Name="GpuPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="#FF4AA3FF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Shows the render workload when it is the GPU load in use." Foreground="#FFAEB7C8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="The GPU load uses Direct3D 11 compute when available, otherwise a simple WPF render load. It is a practical cooler check, not a maximum-power benchmark."
                                       Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: live readings, progress, graph and results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,-10,0">
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="CPU temperature" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock x:Name="CpuTemperatureText" Text="--" Style="{StaticResource MetricValueStyle}" Foreground="#FFDC2626" />
                            <ProgressBar x:Name="CpuTempGauge" Height="6" Minimum="0" Maximum="100" Value="0" ToolTip="How close the CPU is to its stop limit" />
                            <TextBlock x:Name="CpuPeakText" Text="Peak: -- °C" Style="{StaticResource CardDescriptionStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="GPU temperature" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock x:Name="GpuTemperatureText" Text="--" Style="{StaticResource MetricValueStyle}" Foreground="#FFE11D48" />
                            <ProgressBar x:Name="GpuTempGauge" Height="6" Minimum="0" Maximum="100" Value="0" ToolTip="How close the GPU is to its stop limit" />
                            <TextBlock x:Name="GpuPeakText" Text="Peak: -- °C" Style="{StaticResource CardDescriptionStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="CPU power &amp; clock" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock x:Name="CpuPowerText" Text="--" Style="{StaticResource MetricValueStyle}" Foreground="#FFD97706" />
                            <TextBlock x:Name="CpuClockText" Text="--" FontWeight="SemiBold" />
                            <TextBlock x:Name="CpuPowerSourceText" Text="Real sensor only" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CpuClockSourceText" Text="" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="GPU load &amp; power" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock x:Name="GpuLoadText" Text="--" Style="{StaticResource MetricValueStyle}" Foreground="#FF2563EB" />
                            <TextBlock x:Name="GpuPowerText" Text="Power: --" Style="{StaticResource CardDescriptionStyle}" />
                            <TextBlock x:Name="GpuVramText" Text="VRAM: --" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock x:Name="CpuFanText" Text="CPU fan: --" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" />
                            <TextBlock x:Name="CaseFanText" Text="Case fans: --" Style="{StaticResource CardDescriptionStyle}" />
                            <TextBlock x:Name="GpuFanText" Text="GPU fans: --" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Ready. Temperature sensors are being checked." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar x:Name="TestProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Margin="0,8,0,6" />
                            <TextBlock x:Name="SensorDetailText" Text="Reading CPU and GPU sensor availability..." Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Elapsed" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="RemainingText" Text="Remaining: --" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Load" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock x:Name="ActiveLoadText" Text="Idle" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="WorkerDetailText" Text="No workers active" Style="{StaticResource CardDescriptionStyle}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10,12,6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Live thermal graph" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="ChartHintText" Text="Recording since this window opened. Hover to read values, click to pin a moment."
                                           Style="{StaticResource CardDescriptionStyle}" MaxWidth="300" />
                            </StackPanel>
                            <WrapPanel x:Name="ChartSeriesChips" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <controls:LiveChart x:Name="ThermalChart" Grid.Row="1" MinHeight="180" />
                    </Grid>
                </Border>

                <Border x:Name="ResultPanel" Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitleText" Text="Test result" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Fixed footer: acknowledgement and actions always stay visible -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AcknowledgeRiskCheckBox" VerticalAlignment="Center" FontSize="11" Margin="0,0,16,0"
                          Checked="AcknowledgeRiskCheckBox_Changed" Unchecked="AcknowledgeRiskCheckBox_Changed">
                    <TextBlock Text="I understand this creates sustained heat; 105 °C can be near the CPU thermal limit, and I will supervise the test." TextWrapping="Wrap" />
                </CheckBox>
                <Button x:Name="SaveReportButton" Grid.Column="1" Content="Save report" Tag="&#xE74E;" Style="{StaticResource IconButton}" Width="130" IsEnabled="False"
                        Click="SaveReportButton_Click" Margin="0,0,8,0" ToolTip="Save every recorded sample and the test summary as a CSV file" />
                <Button x:Name="StartTestButton" Grid.Column="2" Content="Start load test" Tag="&#xE768;" Style="{StaticResource IconPrimaryButton}" IsEnabled="False"
                        Click="StartTestButton_Click" Width="150" Margin="0" />
                <Button x:Name="StopTestButton" Grid.Column="3" Content="Stop now" Tag="&#xE71A;" Style="{StaticResource IconButton}" IsEnabled="False"
                        Click="StopTestButton_Click" Width="116" Margin="8,0,0,0" />
                <Button x:Name="CloseButton" Grid.Column="4" Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100"
                        Click="CloseButton_Click" Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
