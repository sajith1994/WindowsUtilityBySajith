<Window x:Class="WindowsUtility.Dialogs.RemotePcDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC details"
        Width="940"
        Height="720"
        MinWidth="660"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="PC details" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" VerticalAlignment="Top" Click="RefreshButton_Click" Margin="0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Programs using the PC now -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Using the processor now" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid x:Name="CpuGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserResizeRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="*" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="64" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Using the most memory" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid x:Name="MemoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserResizeRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="*" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="80" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="64" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- Problems from the event logs -->
            <DockPanel Grid.Row="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Crashes and problems (last 30 days)" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProblemSummaryText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <DataGrid x:Name="ProblemsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserResizeRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130" />
                        <DataGridTemplateColumn Header="Type" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Serious}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLine" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100" MinHeight="36" IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
