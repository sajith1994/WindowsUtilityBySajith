<Window x:Class="WindowsUtility.Dialogs.RemoteSpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network speed test"
        Width="560"
        Height="600"
        MinWidth="460"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Network speed test" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SubheadingText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Local network: this PC <-> the monitored PC. -->
                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Local network" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="LanDescriptionText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,10,0" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="LanTestButton" Content="Test local network" Tag="&#xE839;" Style="{StaticResource IconCompactPrimaryButton}" VerticalAlignment="Top" Click="LanTestButton_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Response time" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="LanLatencyText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LanDownloadLabel" Text="Download" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                <TextBlock x:Name="LanDownloadText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LanUploadLabel" Text="Upload" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                <TextBlock x:Name="LanUploadText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Internet, measured on the monitored PC itself. -->
                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="InternetTitleText" Text="Internet" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="InternetDescriptionText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,10,0" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="InternetTestButton" Content="Test internet" Tag="&#xE774;" Style="{StaticResource IconCompactPrimaryButton}" VerticalAlignment="Top" Click="InternetTestButton_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latency" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="InternetLatencyText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Download" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="InternetDownloadText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Upload" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="InternetUploadText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="TestProgress" Height="6" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100" MinHeight="36" IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
