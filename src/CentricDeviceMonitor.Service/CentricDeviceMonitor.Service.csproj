<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>CentricDeviceMonitorService</AssemblyName>
    <RootNamespace>CentricDeviceMonitor.ServiceHost</RootNamespace>
    <Authors>Sajith Varghese</Authors>
    <Product>Windows Utility Background Service</Product>
    <Description>LocalSystem background service for device, temperature, CPU, RAM, and network monitoring.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre708" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="Hwinfo.SharedMemory.Net" Version="2.1.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CentricDeviceMonitor\Models\AppSettings.cs" Link="Models\AppSettings.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\BackgroundServiceSnapshot.cs" Link="Models\BackgroundServiceSnapshot.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\CpuTemperatureLogEntry.cs" Link="Models\CpuTemperatureLogEntry.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\CpuTemperatureSampleEntry.cs" Link="Models\CpuTemperatureSampleEntry.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\DeviceEntry.cs" Link="Models\DeviceEntry.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\DevicePingLogEntry.cs" Link="Models\DevicePingLogEntry.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\SystemHealthLogEntry.cs" Link="Models\SystemHealthLogEntry.cs" />
    <Compile Include="..\CentricDeviceMonitor\Models\PrivilegedServiceCommand.cs" Link="Models\PrivilegedServiceCommand.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\AppSettingsService.cs" Link="Services\AppSettingsService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\BackgroundServiceRuntimeStore.cs" Link="Services\BackgroundServiceRuntimeStore.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\CpuTemperatureLogService.cs" Link="Services\CpuTemperatureLogService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\CpuTemperatureSampleLogService.cs" Link="Services\CpuTemperatureSampleLogService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\DeviceLogService.cs" Link="Services\DeviceLogService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\DeviceStorageService.cs" Link="Services\DeviceStorageService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\HardwareMonitorService.cs" Link="Services\HardwareMonitorService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\NetworkDeviceService.cs" Link="Services\NetworkDeviceService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\SystemHealthLogService.cs" Link="Services\SystemHealthLogService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\SystemResourceMonitorService.cs" Link="Services\SystemResourceMonitorService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\SystemPowerService.cs" Link="Services\SystemPowerService.cs" />
    <Compile Include="..\CentricDeviceMonitor\Services\SharedDataPaths.cs" Link="Services\SharedDataPaths.cs" />
  </ItemGroup>
</Project>
