<Window x:Class="CentricDeviceMonitor.Dialogs.UserApplicationTerminationReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Closed Applications Report - Windows Utility by Sajith"
        Width="1080"
        Height="650"
        MinWidth="760"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Closed user applications" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Only visible non-Windows applications in the current sign-in session are targeted. Windows Utility by Sajith and Windows system executables are excluded."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Open termination log"
                    Tag="&#xE81C;"
                    Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OpenLogButton_Click"
                    Margin="0" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Applications ended" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="EndedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Closed normally" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="ClosedNormallyText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Force terminated" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="ForceTerminatedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Failed / skipped" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="FailedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel>
                    <TextBlock Text="System excluded" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="SystemExcludedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Applications processed" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6" />
                <DataGrid Grid.Row="1"
                          x:Name="ApplicationsGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="170" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="125" />
                        <DataGridTextColumn Header="Window" Binding="{Binding WindowTitle}" Width="2*" />
                        <DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" Width="2*" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Unsaved work may be lost when an application must be force terminated."
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Tag="&#xE711;"
                    Style="{StaticResource IconPrimaryButton}"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    Margin="0" />
        </Grid>
    </Grid>
</Window>
