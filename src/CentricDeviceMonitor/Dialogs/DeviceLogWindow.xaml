<Window x:Class="CentricDeviceMonitor.Dialogs.DeviceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Connection &amp; Restart History"
        Width="1180"
        Height="500"
        MinWidth="720"
        MinHeight="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="DeviceNameText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceIpText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Events: " Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="EntryCountText" FontWeight="SemiBold" />
                    <TextBlock Text="   Active outages: " Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="ActiveCountText" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DataGrid x:Name="LogGrid"
                      ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="{DynamicResource SecondarySurfaceBrush}"
                      ColumnHeaderHeight="32"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event" Binding="{Binding EventTypeDisplay}" Width="1.05*" />
                    <DataGridTextColumn Header="Event at" Binding="{Binding LostAtDisplay}" Width="1.1*" />
                    <DataGridTextColumn Header="Recovered" Binding="{Binding RecoveredAtDisplay}" Width="1.1*" />
                    <DataGridTextColumn Header="Downtime" Binding="{Binding LostDurationDisplay}" Width="0.75*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="0.65*" />
                    <DataGridTextColumn Header="Event details" Binding="{Binding EventDisplay}" Width="2.7*" />
                    <DataGridTextColumn Header="Ping result" Binding="{Binding ErrorDisplay}" Width="1.35*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LogStatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Shutdown/restart reachability events and connection-loss incidents are stored." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconButton}" Click="RefreshButton_Click" />
                <Button Content="Clear incidents" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearButton_Click" />
                <Button Content="Close" Tag="&#xE711;" Style="{StaticResource IconPrimaryButton}" Click="CloseButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
