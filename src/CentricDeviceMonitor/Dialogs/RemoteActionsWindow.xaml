<Window x:Class="CentricDeviceMonitor.Dialogs.RemoteActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actions"
        Width="560"
        Height="640"
        MinWidth="460"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SessionText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Message -->
                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Send a message" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Pops up on the screen of everyone signed in to that PC." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <TextBox x:Name="MessageTextBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" MaxLength="400" />
                        <Button x:Name="SendMessageButton" Content="Send message" Tag="&#xE8BD;" Style="{StaticResource IconCompactPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SendMessageButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Restart / shut down -->
                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Restart or shut down" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="The signed-in user sees a countdown and the message, and can save their work. A scheduled restart or shutdown can be cancelled until it happens." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="After" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="DelayComboBox" Width="140">
                                <ComboBoxItem Content="1 minute" Tag="1" />
                                <ComboBoxItem Content="5 minutes" Tag="5" IsSelected="True" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="Now" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RestartButton" Content="Restart" Tag="&#xE777;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="RestartButton_Click" />
                            <Button x:Name="ShutdownButton" Content="Shut down" Tag="&#xE7E8;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="ShutdownButton_Click" />
                            <Button x:Name="CancelShutdownButton" Content="Cancel scheduled restart" Tag="&#xE711;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="CancelShutdownButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Maintenance -->
                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Maintenance" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Lock the screen (the user signs in again with their password), remove temporary files older than a day, make Windows Update check for updates now, or create a restore point before a risky change." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <WrapPanel>
                            <Button x:Name="LockButton" Content="Lock screen" Tag="&#xE72E;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="LockButton_Click" />
                            <Button x:Name="ClearTempButton" Content="Clear temporary files" Tag="&#xE74D;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="ClearTempButton_Click" />
                            <Button x:Name="UpdateScanButton" Content="Check for Windows updates" Tag="&#xE895;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="UpdateScanButton_Click" />
                            <Button x:Name="RestorePointButton" Content="Create restore point" Tag="&#xE81C;" Style="{StaticResource IconCompactButton}" Margin="0,0,8,6" Click="RestorePointButton_Click"
                                    ToolTip="Saves Windows' system state on that PC, so it can be put back if a change goes wrong. Needs System Protection on." />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Result stays visible below the sections, whatever the scroll position. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                <ProgressBar x:Name="BusyBar" Height="4" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100" MinHeight="36" IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
