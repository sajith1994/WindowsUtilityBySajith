<Window x:Class="CentricDeviceMonitor.Dialogs.ThermalLoadTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU &amp; GPU Thermal Load Test"
        Width="980"
        Height="790"
        MinWidth="900"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="THERMAL DIAGNOSTICS" Style="{StaticResource SectionEyebrowStyle}" />
            <TextBlock Text="CPU &amp; GPU thermal load test" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Create a short, supervised load while watching real temperature sensors to check whether the installed coolers can control heat."
                       Style="{StaticResource SectionDescriptionStyle}"
                       Margin="0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource WarningBrush}" Margin="0,1,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="This test deliberately produces heat" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="Keep the PC supervised and stop if you notice instability, unusual fan noise, smell or display corruption. The test stops at the selected temperature, at the time limit, if required sensor telemetry disappears, or when this window closes. It is a practical cooler check, not hardware certification."
                               Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Test settings" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

                    <TextBlock Text="Load target" Style="{StaticResource InfoLabelStyle}" />
                    <ComboBox x:Name="TestModeComboBox" Margin="0,5,0,8" SelectionChanged="TestModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="CPU only" Tag="Cpu" IsSelected="True" />
                        <ComboBoxItem Content="GPU render load only" Tag="Gpu" />
                        <ComboBoxItem Content="CPU + GPU combined" Tag="Combined" />
                    </ComboBox>

                    <TextBlock Text="GPU adapter" Style="{StaticResource InfoLabelStyle}" />
                    <ComboBox x:Name="GpuAdapterComboBox" Margin="0,5,0,4" />
                    <TextBlock x:Name="GpuLoadModeText" Text="Checking GPU load method..."
                               Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Duration" Style="{StaticResource InfoLabelStyle}" />
                            <ComboBox x:Name="DurationComboBox" Margin="0,5,0,0">
                                <ComboBoxItem Content="30 seconds" Tag="30" />
                                <ComboBoxItem Content="1 minute" Tag="60" IsSelected="True" />
                                <ComboBoxItem Content="2 minutes" Tag="120" />
                                <ComboBoxItem Content="5 minutes" Tag="300" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Load level" Style="{StaticResource InfoLabelStyle}" />
                            <ComboBox x:Name="LoadLevelComboBox" Margin="0,5,0,0">
                                <ComboBoxItem Content="50%" Tag="50" />
                                <ComboBoxItem Content="75%" Tag="75" />
                                <ComboBoxItem Content="100%" Tag="100" IsSelected="True" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CpuLimitLabel" Text="CPU stop temperature: 105 °C" Style="{StaticResource InfoLabelStyle}" />
                            <Slider x:Name="CpuLimitSlider"
                                    Minimum="70"
                                    Maximum="105"
                                    Value="105"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,4,0,0"
                                    ToolTip="105 °C may be at or above the CPU's thermal-throttling point. Keep the test supervised."
                                    ValueChanged="TemperatureLimitSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="GpuLimitLabel" Text="GPU stop temperature: 90 °C" Style="{StaticResource InfoLabelStyle}" />
                            <Slider x:Name="GpuLimitSlider"
                                    Minimum="65"
                                    Maximum="105"
                                    Value="90"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,4,0,0"
                                    ValueChanged="TemperatureLimitSlider_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="GPU render workload" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="RenderingTierText" Text="Checking hardware rendering..." HorizontalAlignment="Right" Style="{StaticResource InfoLabelStyle}" />
                    </Grid>
                    <Border Grid.Row="1" Margin="0,12,0,10" Background="#FF080B12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Viewport3D x:Name="GpuLoadViewport" />
                            <StackPanel x:Name="GpuPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Foreground="#FF4AA3FF" HorizontalAlignment="Center" />
                                <TextBlock Text="GPU render preview" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <TextBlock Text="Choose GPU or Combined, then start the test. WPF uses Direct3D hardware rendering when Windows reports an available rendering tier."
                                           Foreground="#FFAEB7C8" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="The built-in GPU test is a simple WPF/Direct3D render load. Confirm activity using the visible render preview and temperature rise; it may not fully load every discrete GPU or multi-GPU system."
                               Style="{StaticResource CardDescriptionStyle}" />
                </Grid>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="3" Columns="6" Margin="0,0,-12,0">
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="CPU temperature" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="CpuTemperatureText" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="CpuFanText" Text="CPU fan: --" Style="{StaticResource CardDescriptionStyle}" />
                    <TextBlock x:Name="CaseFanText" Text="Case fans: --" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CpuPeakText" Text="Peak: -- °C" Style="{StaticResource CardDescriptionStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="CPU speed" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="CpuClockText" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="CpuClockSourceText" Text="Live reported clock" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="CPU package power" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="CpuPowerText" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="CpuPowerSourceText" Text="Real sensor only" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="GPU temperature" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="GpuTemperatureText" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="GpuPeakText" Text="Peak: -- °C" Style="{StaticResource CardDescriptionStyle}" />
                    <TextBlock x:Name="GpuFanText" Text="GPU fans: --" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="GpuPowerText" Text="Power: --" Style="{StaticResource CardDescriptionStyle}" />
                    <TextBlock x:Name="GpuLoadText" Text="Load: --" Style="{StaticResource CardDescriptionStyle}" />
                    <TextBlock x:Name="GpuVramText" Text="VRAM: --" Style="{StaticResource CardDescriptionStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="Elapsed" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="RemainingText" Text="Remaining: --" Style="{StaticResource CardDescriptionStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" MinHeight="92" Padding="10">
                <StackPanel>
                    <TextBlock Text="Load" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="ActiveLoadText" Text="Idle" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock x:Name="WorkerDetailText" Text="No workers active" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Test status" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="StatusText" Text="Ready. Temperature sensors are being checked." HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar x:Name="TestProgressBar" Minimum="0" Maximum="100" Value="0" Height="10" />
                <TextBlock x:Name="SensorDetailText" Text="Reading CPU and GPU sensor availability..." Style="{StaticResource CardDescriptionStyle}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="AcknowledgeRiskCheckBox"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="11"
                      Margin="0,0,16,0"
                      Checked="AcknowledgeRiskCheckBox_Changed"
                      Unchecked="AcknowledgeRiskCheckBox_Changed">
                <TextBlock Text="I understand this creates sustained heat; 105 °C can be near the CPU thermal limit, and I will supervise the test."
                           TextWrapping="Wrap" />
            </CheckBox>
            <Button x:Name="StartTestButton"
                    Grid.Column="1"
                    Content="Start load test"
                    Tag="&#xE768;"
                    Style="{StaticResource IconPrimaryButton}"
                    IsEnabled="False"
                    Click="StartTestButton_Click"
                    Width="150"
                    Margin="0" />
            <Button x:Name="StopTestButton"
                    Grid.Column="2"
                    Content="Stop now"
                    Tag="&#xE71A;"
                    Style="{StaticResource IconButton}"
                    IsEnabled="False"
                    Click="StopTestButton_Click"
                    Width="116"
                    Margin="8,0,0,0" />
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Content="Close"
                    Tag="&#xE711;"
                    Style="{StaticResource IconButton}"
                    Width="100"
                    Click="CloseButton_Click"
                    Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
