<Window x:Class="CentricDeviceMonitor.Dialogs.SystemHealthLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Health Log"
        Width="1040"
        Height="520"
        MinWidth="720"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="System health events" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="RAM above 90%, CPU at or above 95% for more than one minute, and active Ethernet/Wi-Fi connection losses."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DataGrid x:Name="SystemHealthLogGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="{DynamicResource SecondarySurfaceBrush}"
                      ColumnHeaderHeight="31"
                      RowHeight="31">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.65*" />
                    <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="1.15*" />
                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="1.2*" />
                    <DataGridTextColumn Header="Started" Binding="{Binding StartedAtDisplay}" Width="1.15*" />
                    <DataGridTextColumn Header="Ended" Binding="{Binding EndedAtDisplay}" Width="1.15*" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="0.85*" />
                    <DataGridTextColumn Header="Peak" Binding="{Binding ValueDisplay}" Width="0.7*" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2.1*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconButton}" Click="RefreshButton_Click" />
                <Button Content="Clear completed" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearCompletedButton_Click" />
                <Button Content="Close" Tag="&#xE711;" Style="{StaticResource IconPrimaryButton}" Click="CloseButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
