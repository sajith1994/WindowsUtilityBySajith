<Window x:Class="CentricDeviceMonitor.Dialogs.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terms &amp; Conditions - Windows Utility by Sajith"
        Width="820"
        Height="760"
        MinWidth="620"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <!-- Artwork sits behind the content at low opacity so the licence text stays readable. -->
        <Image Source="pack://application:,,,/Assets/app-artwork.jpg"
               Stretch="UniformToFill"
               Opacity="0.14"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#55000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="0,0,9,0" />
                <TextBlock Text="Terms &amp; Conditions"
                           FontSize="24"
                           FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="End User Licence Agreement, Terms of Use and Disclaimer"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="31,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4">
            <TextBox x:Name="TermsTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     Padding="14"
                     FontFamily="Inter, Segoe UI"
                     FontSize="13"
                     IsTabStop="False" />
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="These terms are also presented for acceptance during interactive installation."
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,16,0" />
            <Button Grid.Column="1"
                    Content="Close"
                    Tag="&#xE711;"
                    Style="{StaticResource IconPrimaryButton}"
                    Width="100"
                    Margin="0"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
    </Grid>
</Window>
