<Window x:Class="CentricDeviceMonitor.Dialogs.StorageDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage Health &amp; Speed"
        Width="1040"
        Height="690"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PageBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Keep the health table useful while giving the detailed test panel enough room. -->
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Storage Health &amp; Speed" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Read Windows disk health/lifetime counters, benchmark sequential speed, and verify writable storage capacity."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh drives" Margin="0,0,7,0" Click="RefreshVolumesButton_Click" />
                    <Button Content="Refresh health" Click="RefreshHealthButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ConnectedVolumesText"
                           Text="Detecting connected storage volumes..."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           HorizontalAlignment="Right"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Physical disk health" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="HealthStatusText" Text="Loading..." Foreground="{DynamicResource MutedTextBrush}" Margin="10,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="Wear = manufacturer's estimated wear limit consumed; some SSDs/HDDs do not report SMART lifetime counters."
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                </Grid>

                <DataGrid Grid.Row="1"
                          x:Name="HealthGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Disk" Binding="{Binding FriendlyName}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="75" />
                        <DataGridTextColumn Header="Bus" Binding="{Binding BusType}" Width="65" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
                        <DataGridTextColumn Header="Health" Binding="{Binding HealthStatus}" Width="80" />
                        <DataGridTextColumn Header="Wear" Binding="{Binding WearText}" Width="85" />
                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingLifeText}" Width="125" />
                        <DataGridTextColumn Header="Power-on" Binding="{Binding PowerOnHoursText}" Width="80" />
                        <DataGridTextColumn Header="Temp" Binding="{Binding TemperatureText}" Width="70" />
                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorText}" Width="105" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <TabItem Header="Speed test">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sequential storage benchmark (SEQ1M Q8T1)" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Creates a temporary test file, measures sequential write/read throughput and removes the file after every pass. Uses 1 MiB transfers at queue depth 8 on a single thread and bypasses the Windows cache, matching CrystalDiskMark's default sequential test. Results are MiB/s; CrystalDiskMark reports MB/s, so its figures read about 5% higher."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,8" />
                        <WrapPanel>
                            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="VolumeComboBox" Width="240" DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                            <TextBlock Text="Test size" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="TestSizeComboBox" Width="150" SelectedIndex="4" Margin="0,0,10,0">
                                <ComboBoxItem Content="64 MB" Tag="64" />
                                <ComboBoxItem Content="128 MB" Tag="128" />
                                <ComboBoxItem Content="256 MB" Tag="256" />
                                <ComboBoxItem Content="512 MB" Tag="512" />
                                <ComboBoxItem Content="1024 MB" Tag="1024" />
                                <ComboBoxItem Content="2048 MB (2 GB)" Tag="2048" />
                                <ComboBoxItem Content="4096 MB (4 GB)" Tag="4096" />
                                <ComboBoxItem Content="8192 MB (8 GB)" Tag="8192" />
                                <ComboBoxItem Content="16384 MB (16 GB)" Tag="16384" />
                                <ComboBoxItem Content="32768 MB (32 GB)" Tag="32768" />
                            </ComboBox>
                            <TextBlock Text="Passes" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="BenchmarkPassCountComboBox" Width="112" SelectedIndex="0">
                                <ComboBoxItem Content="1 pass" Tag="1" />
                                <ComboBoxItem Content="2 passes" Tag="2" />
                                <ComboBoxItem Content="3 passes" Tag="3" />
                                <ComboBoxItem Content="4 passes" Tag="4" />
                                <ComboBoxItem Content="5 passes" Tag="5" />
                                <ComboBoxItem Content="Continuous" Tag="CONTINUOUS" />
                            </ComboBox>
                        </WrapPanel>
                        <ProgressBar x:Name="BenchmarkProgressBar" Minimum="0" Maximum="100" Height="7" Margin="0,9,0,4" />
                        <TextBlock x:Name="BenchmarkStatusText" Text="Ready." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Latest write:" FontWeight="SemiBold" />
                            <TextBlock x:Name="WriteSpeedText" Text="-- MB/s" Margin="5,0,18,0" />
                            <TextBlock Text="Latest read:" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReadSpeedText" Text="-- MB/s" Margin="5,0,18,0" />
                        </WrapPanel>
                        <TextBlock x:Name="ContinuousSummaryText" Text="" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="CacheWarningText" Text="" Foreground="#D97706" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Button x:Name="RunBenchmarkButton" Content="Run speed test" Margin="0,0,0,7" Click="RunBenchmarkButton_Click" />
                        <Button x:Name="CancelBenchmarkButton" Content="Stop / Cancel" Margin="0,0,0,7" IsEnabled="False" Click="CancelBenchmarkButton_Click" />
                        <Button Content="Open benchmark log" Margin="0" Click="OpenBenchmarkLogButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Capacity verification">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Real-capacity verification" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Writes unique data into FREE SPACE, then reads every block back. This can detect counterfeit/overstated flash storage. Use an empty/non-critical drive for a full test because counterfeit wraparound can corrupt existing data."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,7" />
                        <WrapPanel>
                            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="CapacityVolumeComboBox" Width="240" DisplayMemberPath="DisplayName" Margin="0,0,10,0" SelectionChanged="CapacityVolumeComboBox_SelectionChanged" />
                            <TextBlock Text="Test amount" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="CapacityAmountComboBox" Width="135" SelectedIndex="2">
                                <ComboBoxItem Content="1 GB" Tag="1" />
                                <ComboBoxItem Content="5 GB" Tag="5" />
                                <ComboBoxItem Content="10 GB" Tag="10" />
                                <ComboBoxItem Content="25 GB" Tag="25" />
                                <ComboBoxItem Content="50 GB" Tag="50" />
                                <ComboBoxItem Content="All safe free space" Tag="ALL" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock x:Name="CapacitySafetyText" Text="Select a volume to see the maximum safe test size." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,6,0,0" />
                        <ProgressBar x:Name="CapacityProgressBar" Minimum="0" Maximum="100" Height="7" Margin="0,8,0,4" />
                        <TextBlock x:Name="CapacityStatusText" Text="Ready." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="STEP 1" Foreground="{DynamicResource PrimaryBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <TextBlock Text="Copying test data to drive" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="WriteStepStatusText" Text="Waiting" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar x:Name="WriteStepProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,0,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,7,5"><TextBlock Text="Current write" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteCurrentSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,7,5"><TextBlock Text="Average write" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteAverageSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,5"><TextBlock Text="Top write" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteFastestSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Elapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteElapsedText" Text="00:00:00" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Estimated left" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteEtaText" Text="--:--:--" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Written" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="WriteProgressText" Text="0 B / 0 B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="STEP 2" Foreground="{DynamicResource PrimaryBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <TextBlock Text="Verifying copied data" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="VerifyStepStatusText" Text="Waiting for step 1" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar x:Name="VerifyStepProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,0,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,7,5"><TextBlock Text="Current read" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyCurrentSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,7,5"><TextBlock Text="Average read" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyAverageSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,5"><TextBlock Text="Top read" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyFastestSpeedText" Text="-- MB/s" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Elapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyElapsedText" Text="00:00:00" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Estimated left" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyEtaText" Text="--:--:--" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Verified" Foreground="{DynamicResource MutedTextBrush}" FontSize="9"/><TextBlock x:Name="VerifyProgressText" Text="0 B / 0 B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CapacityOverallPercentText" Text="Overall progress 0.0%" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                            <TextBlock Grid.Column="1" x:Name="CapacityTotalElapsedText" Text="Total elapsed 00:00:00" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                        </Grid>

                        <TextBlock x:Name="CapacityResultText" Text="" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Button x:Name="RunCapacityButton" Content="Start verification" Margin="0,0,0,7" Click="RunCapacityButton_Click" />
                        <Button x:Name="CancelCapacityButton" Content="Stop / Cancel" Margin="0,0,0,7" IsEnabled="False" Click="CancelCapacityButton_Click" />
                        <Button Content="Open verification log" Margin="0" Click="OpenCapacityLogButton_Click" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Capacity verification can write a large amount of data and may take hours. It keeps a safety reserve and deletes its test files afterward."
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="9" VerticalAlignment="Center" />
            <Button Content="Close" HorizontalAlignment="Right" Margin="0" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
