<Window x:Class="CentricDeviceMonitor.Dialogs.TemporaryFileCleanupReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary File Cleanup Report - Windows Utility by Sajith"
        Width="1080"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Temporary file cleanup report" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Deleted and skipped Temp items from this cleanup run. Reclaimed space is calculated from successfully deleted files."
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Open cleanup log"
                    Tag="&#xE81C;"
                    Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OpenLogButton_Click"
                    Margin="0" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Space reclaimed" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="SpaceReclaimedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Free-space change" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="FreeSpaceChangeText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Files deleted" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="FilesDeletedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Folders deleted" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="FoldersDeletedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel>
                    <TextBlock Text="Skipped" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="SkippedText" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Deleted / skipped items" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6" />
                <DataGrid Grid.Row="1"
                          x:Name="ItemsGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="95" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="75" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Content="Close"
                    Tag="&#xE711;"
                    Style="{StaticResource IconPrimaryButton}"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    Margin="0" />
        </Grid>
    </Grid>
</Window>
