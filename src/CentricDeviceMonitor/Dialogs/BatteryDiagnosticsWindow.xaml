<Window x:Class="CentricDeviceMonitor.Dialogs.BatteryDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Health - Windows Utility"
        Width="1050"
        Height="620"
        MinWidth="850"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE850;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Laptop battery health &amp; life" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Battery capacity, health, charge, estimated runtime, cycle count and hardware identity reported by Windows. Remaining runtime is an estimate and changes with workload."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshButton_Click" Margin="0,0,6,0" />
                <Button x:Name="GenerateReportButton" Content="Windows battery report" Tag="&#xE9D5;" Style="{StaticResource IconCompactButton}" Click="GenerateReportButton_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,10">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Charge remaining" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="ChargeRemainingText" Text="--" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentCapacityText" Text="Current capacity: --" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="2,0,4,0">
                <StackPanel>
                    <TextBlock Text="Battery health" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="BatteryHealthText" Text="--" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CapacityComparisonText" Text="Full charge / design: --" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="4,0,2,0">
                <StackPanel>
                    <TextBlock Text="Remaining runtime" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="RemainingRuntimeText" Text="--" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="BatteryStateText" Text="State: --" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Battery identity" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="BatteryModelText" Text="--" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <TextBlock x:Name="BatteryManufacturerText" Text="--" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Detected batteries" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Reading battery telemetry..." HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                </Grid>
                <DataGrid Grid.Row="1" x:Name="BatteryGrid" Margin="0,7,0,0" SelectionChanged="BatteryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="170" />
                        <DataGridTextColumn Header="Brand" Binding="{Binding Manufacturer}" Width="110" />
                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90" />
                        <DataGridTextColumn Header="Charge" Binding="{Binding ChargeRemainingText}" Width="65" />
                        <DataGridTextColumn Header="Runtime" Binding="{Binding RemainingRuntimeText}" Width="90" />
                        <DataGridTextColumn Header="Design" Binding="{Binding DesignedCapacityText}" Width="85" />
                        <DataGridTextColumn Header="Full charge" Binding="{Binding FullChargeCapacityText}" Width="85" />
                        <DataGridTextColumn Header="Current" Binding="{Binding RemainingCapacityText}" Width="85" />
                        <DataGridTextColumn Header="Health" Binding="{Binding HealthText}" Width="70" />
                        <DataGridTextColumn Header="Cycles" Binding="{Binding CycleCountText}" Width="70" />
                        <DataGridTextColumn Header="Chemistry" Binding="{Binding Chemistry}" Width="90" />
                        <DataGridTextColumn Header="Voltage" Binding="{Binding VoltageText}" Width="75" />
                        <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" Width="75" />
                        <DataGridTextColumn Header="Serial / ID" Binding="{Binding SerialNumber}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Health = current full-charge capacity ÷ original designed capacity. When firmware/WMI hides static values, Windows Utility supplements them from the built-in Windows powercfg battery-report XML. Unsupported values remain Not reported."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="9"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,90,0" />
            <Button Content="Close" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" MinWidth="75" />
        </Grid>
    </Grid>
</Window>
