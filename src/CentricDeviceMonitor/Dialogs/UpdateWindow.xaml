<Window x:Class="CentricDeviceMonitor.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for updates"
        Width="560"
        Height="460"
        MinWidth="480"
        MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Software update" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Grid.Row="0" Text="Checking for updates..." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                </ScrollViewer>
                <ProgressBar x:Name="DownloadProgress" Grid.Row="2" Height="8" Minimum="0" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed" />
            </Grid>
        </Border>

        <CheckBox x:Name="AutoCheckBox"
                  Grid.Row="2"
                  Content="Check for updates when the app starts"
                  Margin="0,12,0,0"
                  Checked="AutoCheckBox_Changed"
                  Unchecked="AutoCheckBox_Changed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CheckButton" Grid.Column="0" Content="Check again" Tag="&#xE72C;" Style="{StaticResource IconButton}" MinWidth="130" Click="CheckButton_Click" Margin="0" />
            <Button x:Name="UpdateButton" Grid.Column="2" Content="Update now" Tag="&#xE896;" Style="{StaticResource IconPrimaryButton}" MinWidth="140" Visibility="Collapsed" Click="UpdateButton_Click" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Grid.Column="3" Content="Close" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="100" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>
