<Window x:Class="CentricDeviceMonitor.Dialogs.WindowsRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Repair &amp; Recovery"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Windows Repair &amp; Recovery" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Administrator shortcuts for online Windows repair, disk checking, boot recovery and offline DISM/SFC operations."
                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Use with care" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="SFC and DISM can repair Windows files; CHKDSK /f /r can take a long time and may schedule work for the next restart. BootRec changes boot configuration and is normally intended for Windows Recovery Environment (WinRE). Confirm the target drive before running offline commands."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Online Windows repair" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Runs against the Windows installation that is currently booted. Commands open in an Administrator Command Prompt so progress and final results remain visible."
                                   Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14" />
                        <UniformGrid Columns="4">
                            <Button Content="SFC /scannow" Tag="&#xE9D9;" Style="{StaticResource IconCompactPrimaryButton}" Click="SfcOnlineButton_Click" Margin="0,0,6,6" ToolTip="Use when Windows system files may be corrupted or missing." />
                            <Button Content="DISM CheckHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactButton}" Click="DismOnlineCheckButton_Click" Margin="0,0,6,6" ToolTip="Quickly check whether the Windows image is already flagged as corrupt." />
                            <Button Content="DISM ScanHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactButton}" Click="DismOnlineScanButton_Click" Margin="0,0,6,6" ToolTip="Deep-scan the running Windows component store for corruption." />
                            <Button Content="DISM RestoreHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactPrimaryButton}" Click="DismOnlineRestoreButton_Click" Margin="0,0,0,6" ToolTip="Repair Windows image corruption using Windows Update or configured repair source." />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Disk check" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Check the selected volume for file-system errors and bad sectors. On an in-use Windows volume, Windows will normally offer to schedule the repair for the next restart."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drive" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="ChkdskDriveTextBox" Margin="8,0,0,0" Text="C:" ToolTip="Drive letter, for example C:" />
                            <Button Grid.Column="3" Content="Run CHKDSK /f /r" Tag="&#xE7C3;" Style="{StaticResource IconCompactPrimaryButton}" HorizontalAlignment="Left" MinWidth="180" Click="ChkdskButton_Click" Margin="0" ToolTip="Repair file-system errors and scan the selected volume for bad sectors." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="Offline Windows image repair" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Detect Windows drive" Tag="&#xE721;" Style="{StaticResource IconCompactButton}" Click="DetectWindowsDriveButton_Click" Margin="0" ToolTip="Read BCDEdit osdevice to identify the Windows drive letter used in recovery." />
                        </Grid>
                        <TextBlock Text="Use this when repairing an offline Windows installation, including from recovery media. The drive letter in WinRE may not be C:. Detect it first or enter the correct drive manually."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Windows drive" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="OfflineWindowsDriveTextBox" Margin="8,0,0,0" Text="C:" ToolTip="Offline Windows drive letter, for example D:" />
                            <TextBlock Grid.Column="3" x:Name="DetectedDriveStatusText" Text="Confirm the drive that contains the Windows folder before running offline repair." Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <UniformGrid Columns="4">
                            <Button Content="Offline CheckHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactButton}" Click="DismOfflineCheckButton_Click" Margin="0,0,6,6" ToolTip="Check an offline Windows image for known component-store corruption." />
                            <Button Content="Offline ScanHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactButton}" Click="DismOfflineScanButton_Click" Margin="0,0,6,6" ToolTip="Deep-scan an offline Windows image for corruption." />
                            <Button Content="Offline RestoreHealth" Tag="&#xE9D9;" Style="{StaticResource IconCompactPrimaryButton}" Click="DismOfflineRestoreButton_Click" Margin="0,0,6,6" ToolTip="Repair an offline Windows image using DISM." />
                            <Button Content="Offline SFC" Tag="&#xE9D9;" Style="{StaticResource IconCompactPrimaryButton}" Click="SfcOfflineButton_Click" Margin="0,0,0,6" ToolTip="Run SFC against the selected offline Windows installation after DISM repair." />
                        </UniformGrid>
                        <Button Content="Run DISM Check + Scan + Restore, then Offline SFC" Tag="&#xE768;" Style="{StaticResource IconCompactButton}" HorizontalAlignment="Stretch" Click="OfflineRepairSequenceButton_Click" Margin="0,2,0,0" ToolTip="Run offline DISM Check/Scan/Restore followed by offline SFC in the recommended sequence." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Text="Boot records (WinRE)" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="BootRecAvailabilityText"
                                   Text="BootRec availability is being checked. These commands are normally used from Windows Recovery Environment, not from a normal desktop session."
                                   Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14" />
                        <UniformGrid Columns="4">
                            <Button Content="Fix MBR" Tag="&#xE7BA;" Style="{StaticResource IconCompactButton}" Click="BootRecFixMbrButton_Click" Margin="0,0,6,6" ToolTip="Rewrite the master boot record from Windows Recovery Environment." />
                            <Button Content="Fix boot sector" Tag="&#xE7BA;" Style="{StaticResource IconCompactButton}" Click="BootRecFixBootButton_Click" Margin="0,0,6,6" ToolTip="Repair the boot sector from Windows Recovery Environment." />
                            <Button Content="Rebuild BCD" Tag="&#xE7BA;" Style="{StaticResource IconCompactButton}" Click="BootRecRebuildBcdButton_Click" Margin="0,0,6,6" ToolTip="Scan for Windows installations and rebuild Boot Configuration Data." />
                            <Button Content="Run boot repair sequence" Tag="&#xE768;" Style="{StaticResource IconCompactPrimaryButton}" Click="BootRecSequenceButton_Click" Margin="0,0,0,6" ToolTip="Run FixMBR, FixBoot and RebuildBCD as a guarded recovery sequence." />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready." Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Close" Tag="&#xE711;" Style="{StaticResource IconPrimaryButton}" Width="100" Click="CloseButton_Click" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
