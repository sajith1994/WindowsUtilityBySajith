<Window x:Class="CentricDeviceMonitor.Dialogs.CpuTemperatureLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Temperature Log"
        Width="980"
        Height="540"
        MinWidth="720"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="CPU temperature history" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="The LocalSystem background service records one real CPU-specific temperature sample every minute. Generic ACPI thermal zones are never written to this log."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Temperature samples">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,4,0,0">
                    <DataGrid x:Name="TemperatureSampleGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="{DynamicResource SecondarySurfaceBrush}"
                              ColumnHeaderHeight="30"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtDisplay}" Width="1.3*" />
                            <DataGridTextColumn Header="Temperature" Binding="{Binding TemperatureDisplay}" Width="0.9*" />
                            <DataGridTextColumn Header="CPU sensor" Binding="{Binding SensorName}" Width="2*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Overheat incidents">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,4,0,0">
                    <DataGrid x:Name="TemperatureLogGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="{DynamicResource SecondarySurfaceBrush}"
                              ColumnHeaderHeight="30"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.7*" />
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAtDisplay}" Width="1.2*" />
                            <DataGridTextColumn Header="Ended" Binding="{Binding EndedAtDisplay}" Width="1.35*" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="0.85*" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTemperatureDisplay}" Width="0.7*" />
                            <DataGridTextColumn Header="Peak" Binding="{Binding PeakTemperatureDisplay}" Width="0.7*" />
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="1.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconButton}" Click="RefreshButton_Click" />
                <Button Content="Clear samples" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearSamplesButton_Click" />
                <Button Content="Clear completed events" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearCompletedButton_Click" />
                <Button Content="Close" Tag="&#xE711;" Style="{StaticResource IconPrimaryButton}" Click="CloseButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
