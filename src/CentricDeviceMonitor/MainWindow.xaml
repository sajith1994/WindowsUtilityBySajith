                        </controls:DashboardPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- NETWORK DIAGNOSTICS -->
                <ScrollViewer x:Name="NetworkDiagnosticsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,32" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <TextBlock Text="NETWORK" Style="{StaticResource SectionEyebrowStyle}" />
                        <TextBlock Text="Network diagnostics" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="See managed-device reachability immediately, scan the local subnet and inspect the current network path."
                                   Style="{StaticResource SectionDescriptionStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="IP Scanner &amp; Monitoring" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Discover devices on the local subnet and configure automatic availability checks."
                                               Style="{StaticResource CardDescriptionStyle}" />
                                    <Button Content="Open IP scanner &amp; manage addresses"
                                            Tag="&#xE721;"
                                            Style="{StaticResource IconPrimaryButton}"
                                            Click="OpenIpScannerButton_Click"
                                            Margin="0,16,0,16"
                                            ToolTip="Scan the local IPv4 subnet, manage monitored IPs and check common TCP ports." />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="AutomaticMonitoringCheckBox"
                                                      Content="Automatic ping monitoring"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      FontSize="11"
                                                      Checked="AutomaticMonitoringCheckBox_Changed"
                                                      Unchecked="AutomaticMonitoringCheckBox_Changed"
                                                      ToolTip="Enable background ping checks for saved managed devices and log outages/recoveries." />
                                        <TextBlock Grid.Column="1" Text="Live status below" Style="{StaticResource InfoLabelStyle}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Interval" Style="{StaticResource InfoLabelStyle}" />
                                        <ComboBox Grid.Column="1" x:Name="PingIntervalComboBox" Margin="8,0,12,0" FontSize="11" SelectionChanged="PingIntervalComboBox_SelectionChanged" ToolTip="Choose how often saved managed devices are checked for reachability.">
                                            <ComboBoxItem Content="10 seconds" Tag="10"/><ComboBoxItem Content="15 seconds" Tag="15"/><ComboBoxItem Content="30 seconds" Tag="30"/>
                                            <ComboBoxItem Content="1 minute" Tag="60"/><ComboBoxItem Content="2 minutes" Tag="120"/><ComboBoxItem Content="5 minutes" Tag="300"/><ComboBoxItem Content="10 minutes" Tag="600"/><ComboBoxItem Content="30 minutes" Tag="1800"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" x:Name="PingCountdownText" Text="Next ping: --:--" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE95E;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                            <TextBlock Text="Current Connection" Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshSystemHealthDetailsButton_Click" Margin="0" ToolTip="Refresh local adapter, gateway/DNS and public connection details." />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Network" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="NetworkStatusText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Text="Wi-Fi" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="WifiStrengthText" Text="Checking signal..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="2" Text="Local IP" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="LocalIpText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Text="Gateway / DNS" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="GatewayDnsText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="4" Text="Public IP" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="PublicIpText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4"/>
                                        <TextBlock Grid.Row="5" Text="IP location" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="PublicLocationText" Text="Checking IP location..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="6" Text="ISP / server" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="PublicServerText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="7" Text="Adapters" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="7" Grid.Column="1" x:Name="NetworkDetailText" Text="Checking adapters..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="8" Text="Link bandwidth" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="8" Grid.Column="1" x:Name="ActiveLinkSpeedText" Text="Checking active link..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="Negotiated Ethernet/Wi-Fi link rate. Works even when the internet is unavailable."/>
                                    </Grid>
                                    <TextBlock x:Name="SystemHealthUpdatedText" Text="Extended details refresh automatically." Style="{StaticResource CardDescriptionStyle}" Margin="0,12,0,10" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Packet loss &amp; speed tests" Tag="&#xE721;" Style="{StaticResource IconCompactPrimaryButton}" Click="OpenNetworkSpeedTestButton_Click" Margin="0,0,6,0" ToolTip="Tests packet loss and jitter, shows local link bandwidth, opens FAST.com for internet speed, and measures actual PC-to-PC LAN throughput without internet." />
                                        <Button Content="View system health log" Tag="&#xE81C;" Style="{StaticResource IconCompactButton}" Click="ViewSystemHealthLogButton_Click" Margin="0" ToolTip="Review saved system/network health samples and changes." />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Network Troubleshooting Shortcuts" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Launch common built-in Windows networking commands in a Command Prompt. Target-based tools use the host or IP below."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="NetworkCommandTargetTextBox" Text="google.com" ToolTip="Hostname or IP address for Ping, Tracert and NSLookup"/>
                                    <TextBlock Grid.Column="2" Text="Examples: google.com, 8.8.8.8, 192.168.1.1" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <UniformGrid Columns="5" Rows="2">
                                    <StackPanel Margin="0,0,6,10"><Button Content="IP config" Tag="&#xE968;" Style="{StaticResource IconCompactButton}" Click="NetworkIpConfigButton_Click" ToolTip="ipconfig /all - inspect IP, DNS, DHCP and gateway settings." Margin="0"/><TextBlock Text="IP, DNS, DHCP and gateways for all adapters." Style="{StaticResource ShortcutHelpStyle}"/></StackPanel>
