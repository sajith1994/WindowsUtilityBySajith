                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Action" Style="{StaticResource InfoLabelStyle}"/>
                                            <ComboBox Grid.Column="1" x:Name="PowerActionComboBox" Margin="8,0,18,0" SelectionChanged="PowerScheduleSelection_Changed"><ComboBoxItem Content="Restart" Tag="Restart"/><ComboBoxItem Content="Shutdown" Tag="Shutdown"/></ComboBox>
                                            <TextBlock Grid.Column="2" Text="Time" Style="{StaticResource InfoLabelStyle}"/>
                                            <ComboBox Grid.Column="3" x:Name="PowerHourComboBox" Margin="8,0,4,0" SelectionChanged="PowerScheduleSelection_Changed"/>
                                            <TextBlock Grid.Column="4" Text=":" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <ComboBox Grid.Column="5" x:Name="PowerMinuteComboBox" Margin="4,0,0,0" SelectionChanged="PowerScheduleSelection_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="0" x:Name="PowerScheduleToggle" Content="Power scheduler disabled" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Checked="PowerScheduleToggle_Changed" Unchecked="PowerScheduleToggle_Changed" ToolTip="Master enable/disable switch for unattended scheduled shutdown or restart."/>
                                            <ToggleButton Grid.Column="1" x:Name="ForcePowerActionToggle" Content="Force close apps" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Checked="ForcePowerActionToggle_Changed" Unchecked="ForcePowerActionToggle_Changed"/>
                                        </Grid>
                                        <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Schedule  " Style="{StaticResource InfoLabelStyle}"/><TextBlock x:Name="PowerScheduleEnabledStateText" Text="Disabled" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Countdown  " Style="{StaticResource InfoLabelStyle}"/><TextBlock x:Name="PowerScheduleCountdownText" Text="--:--:--" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="PowerScheduleStatusText" Text="Automatic Windows shutdown/restart is disabled." Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="The scheduler settings remain saved when disabled. Unattended execution requires the Background Monitoring service to be enabled and running." Style="{StaticResource ShortcutHelpStyle}" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2"><Button Content="Run action now" Tag="&#xE768;" Style="{StaticResource IconCompactPrimaryButton}" Click="RunPowerActionNowButton_Click" Margin="0,0,6,0"/><Button x:Name="PowerScheduleControlButton" Content="Enable scheduler" Tag="&#xE768;" Style="{StaticResource IconCompactButton}" Click="TogglePowerScheduleButton_Click" Margin="0"/></UniformGrid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <TextBlock Text="Windows Power Plan" Style="{StaticResource CardTitleStyle}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshPowerPlansButton_Click" Margin="0"/>
                                        </Grid>
                                        <TextBlock Text="Active plan" Style="{StaticResource InfoLabelStyle}" Margin="0,4,0,2" />
                                        <TextBlock x:Name="ActivePowerPlanText" Text="Checking..." FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ActivePowerPlanDetailText" Text="Reading Windows power configuration..." Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,14" TextWrapping="Wrap" />

                                        <TextBlock Text="Change power plan" Style="{StaticResource InfoLabelStyle}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="PowerPlanComboBox" DisplayMemberPath="Name" MinHeight="34" Margin="0,0,0,10" />
                                        <Button x:Name="SetActivePowerPlanButton" Content="Set selected plan active" Tag="&#xE73E;" Style="{StaticResource IconCompactPrimaryButton}" Click="SetActivePowerPlanButton_Click" Margin="0,0,0,12" />

                                        <UniformGrid Columns="2">
                                            <Button Content="Power Options" Tag="&#xE713;" Style="{StaticResource IconCompactButton}" Click="OpenPowerOptionsButton_Click" Margin="0,0,5,0" />
                                            <Button Content="Lid &amp; power buttons" Tag="&#xE7E8;" Style="{StaticResource IconCompactButton}" Click="OpenLidOptionsButton_Click" Margin="5,0,0,0" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83F;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}"/><TextBlock Text="Battery Health" Style="{StaticResource CardTitleStyle}"/></StackPanel>
                                        <TextBlock x:Name="BatteryPercentText" Text="Checking..." FontSize="24" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                        <TextBlock Text="Charge, runtime, design/full capacity, health, voltage, cycles and Windows battery report." Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14"/>
                                        <Button Content="Open battery diagnostics" Tag="&#xE83F;" Style="{StaticResource IconCompactPrimaryButton}" Click="OpenBatteryDiagnosticsButton_Click" Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- NETWORK PCS: remote monitoring between copies of this app on the local network. -->
                <ScrollViewer x:Name="NetworkPcsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,32" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <TextBlock Text="REMOTE MONITORING" Style="{StaticResource SectionEyebrowStyle}" />
                        <TextBlock Text="Network PCs" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Watch CPU load, temperature, memory and storage of other PCs on your local network. Every PC uses this same app: turn on sharing on each PC you want to watch, then add it here with the pairing code it shows."
                                   Style="{StaticResource SectionDescriptionStyle}" />

                        <!-- This PC: let other PCs read its stats. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE977;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="This PC" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="SharingStatusText" Text="Sharing is off" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <ToggleButton x:Name="RemoteSharingToggle"
                                              Content="Allow this PC to be monitored from other PCs on the local network"
                                              Style="{StaticResource ToggleSwitch}"
                                              FontSize="11"
                                              Checked="RemoteSharingToggle_Changed"
                                              Unchecked="RemoteSharingToggle_Changed"
                                              ToolTip="The background service answers with this PC's stats to PCs that have the pairing code. Nothing can be changed remotely." />
                                <TextBlock Text="Other PCs can only read stats (CPU, temperature, memory, disks, uptime), and only PCs with the pairing code can read anything. Nothing on this PC can be changed remotely unless you allow actions below. Windows Firewall allows the port from the local network on Private networks only."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" />

                                <Border x:Name="SharingDetailsPanel" Visibility="Collapsed" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Pairing code" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <!-- Editable until a PC connects with the code; then hidden until the current code is re-entered. -->
                                            <StackPanel x:Name="SharingCodeEditPanel" Orientation="Horizontal">
                                                <TextBox x:Name="SharingCodeBox" Width="240" Height="34" Padding="8,2" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                                         VerticalContentAlignment="Center" CharacterCasing="Upper" MaxLength="40" TextChanged="SharingCodeBox_TextChanged"
                                                         ToolTip="Type your own code to use the same one on several PCs. At least 8 letters or numbers." />
                                                <Button x:Name="SaveSharingCodeButton" Content="Save code" Style="{StaticResource HeaderMiniButton}" Click="SaveSharingCodeButton_Click" Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="False" />
                                                <Button Content="Random" Style="{StaticResource HeaderMiniButton}" Click="NewSharingCodeButton_Click" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Fill in a random code (Save code to use it)." />
                                                <Button Content="Copy" Style="{StaticResource HeaderMiniButton}" Click="CopySharingCodeButton_Click" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="SharingCodeLockedPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBlock Text="••••-••••-••••" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Content="Show or change" Style="{StaticResource HeaderMiniButton}" Click="UnlockSharingCodeButton_Click" Margin="14,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Asks for the current code first, so it cannot be changed by accident." />
                                            </StackPanel>
                                            <TextBlock x:Name="SharingCodeHintText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Add it as" Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SharingAddressText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Text="Monitored by" Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SharingViewersText" Text="No PC has connected yet." FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Text="Network" Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SharingNetworkText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="RemoteActionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <ToggleButton x:Name="RemoteActionsToggle" Content="Allow actions from the main PC" Style="{StaticResource ToggleSwitch}" FontSize="11"
                                                  Checked="RemoteActionsToggle_Changed" Unchecked="RemoteActionsToggle_Changed"
                                                  ToolTip="Lets the PC monitoring this one restart or shut it down, lock it, show a message, clear temporary files or start a Windows Update check." />
                                    <TextBlock Text="Off by default. When on, the PC monitoring this one (with the pairing code) can restart or shut down this PC with a countdown, lock it, show a message, clear temporary files and start a Windows Update check. Each action is logged here."
                                               Style="{StaticResource CardDescriptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PCs monitored from this PC. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Monitored PCs" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="RemotePcsCountText" Text="" Style="{StaticResource InfoLabelStyle}" Margin="10,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Export report" Tag="&#xE9F9;" Style="{StaticResource IconCompactButton}" Click="ExportInventoryReportButton_Click" Margin="0,0,8,0"
                                                ToolTip="Save an inventory of every monitored PC: a printable report (save it as PDF from the browser) or a CSV file for Excel." />
                                        <Button x:Name="UpdateAllRemotePcsButton" Content="Update all" Tag="&#xE777;" Style="{StaticResource IconCompactButton}" Click="UpdateAllRemotePcsButton_Click" Margin="0,0,8,0"
                                                ToolTip="Ask every monitored PC with an older Windows Utility to update itself to the latest release." />
                                        <Button x:Name="FindRemotePcsButton" Content="Find PCs" Tag="&#xE721;" Style="{StaticResource IconCompactButton}" Click="FindRemotePcsButton_Click" Margin="0,0,8,0"
                                                ToolTip="Search this network for PCs running Windows Utility with sharing turned on." />
                                        <Button Content="Add PC" Tag="&#xE710;" Style="{StaticResource IconCompactPrimaryButton}" Click="AddRemotePcButton_Click" Margin="0"
                                                ToolTip="Add a PC by name or IP address and its pairing code." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Live tiles refresh every 5 seconds while this page is open. A tile turns amber when a PC runs hot, a disk is over 90% full or the code is wrong, and red when the PC cannot be reached."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <ToggleButton x:Name="RemoteAlertsToggle" Content="Notify me when a monitored PC has a problem" Style="{StaticResource ToggleSwitch}" FontSize="11"
                                                      Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed"
                                                      ToolTip="Checked every 30 seconds in the background, also while the dashboard is only in the notification area." />
                                        <WrapPanel x:Name="RemoteAlertOptionsPanel" Margin="0,8,0,0">
                                            <CheckBox x:Name="RemoteAlertOverheatCheck" Content="Overheating (above that PC's alert temperature)" FontSize="11" Margin="0,0,18,6" Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed" />
                                            <CheckBox x:Name="RemoteAlertDiskCheck" Content="Drive nearly full (under 10% free) or full" FontSize="11" Margin="0,0,18,6" Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed" />
                                            <CheckBox x:Name="RemoteAlertMemoryCheck" Content="Memory over 95%" FontSize="11" Margin="0,0,18,6" Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed" />
                                            <CheckBox x:Name="RemoteAlertOfflineCheck" Content="PC goes offline (and when it is back)" FontSize="11" Margin="0,0,18,6" Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed" />
                                            <CheckBox x:Name="RemoteAlertSecurityCheck" Content="Security (antivirus or firewall off, no Windows updates for 30 days)" FontSize="11" Margin="0,0,18,6" Checked="RemoteAlertSetting_Changed" Unchecked="RemoteAlertSetting_Changed" />
                                        </WrapPanel>
                                        <TextBlock x:Name="RemoteAlertsNoteText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecentRemoteAlertsText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FoundPcsPanel" Visibility="Collapsed" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FoundPcsHeaderText" Text="Found on the network" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="AddAllFoundPcsButton" Content="Add all" Tag="&#xE710;" Style="{StaticResource IconCompactPrimaryButton}" Click="AddAllFoundPcsButton_Click" Margin="0"
                                                    Visibility="Collapsed" ToolTip="Add every PC found, using the network code (the code set on those PCs)." />
                                        </Grid>
                                        <ItemsControl x:Name="FoundPcsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Hello.MachineName}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Style="{StaticResource CardDescriptionStyle}">
                                                                <Run Text="{Binding Address, Mode=OneWay}" /><Run Text="  •  Windows Utility " /><Run Text="{Binding Hello.AppVersion, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Add" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="AddFoundPcButton_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="FoundPcsEmptyText" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="RemotePcsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="300" Margin="0,0,12,12" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel ToolTip="{Binding AddressToolTip}">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SessionsText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasStats}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ModelText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasModel}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Online"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Offline"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE895;" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Online"><Setter Property="Text" Value="&#xE73E;" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="#1F1F1F" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Offline"><Setter Property="Text" Value="&#xE711;" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Style.Triggers>
                                                                            <!-- Amber is light in dark mode; dark text keeps it readable in both themes. -->
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Foreground" Value="#1F1F1F" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            </StackPanel>

                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasStats}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Margin="0,10,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasStats}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Grid ToolTip="{Binding CpuModel}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                            <ProgressBar Grid.Column="1" Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding CpuModel}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="44,1,0,0" />
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="Temp" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                                                <Run Text="{Binding TemperatureText, Mode=OneWay}" FontWeight="SemiBold">
                                                                    <Run.Style>
                                                                        <Style TargetType="Run">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHot}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Run.Style>
                                                                </Run>
                                                            </TextBlock>
                                                        </Grid>
                                                        <TextBlock Text="{Binding TemperatureDetail}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="44,1,0,0" />
                                                        <Grid Margin="0,6,0,0" ToolTip="{Binding RamDetail}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                            <ProgressBar Grid.Column="1" Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding RamText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding RamDetail}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="44,1,0,0" />
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSecurity}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="Security" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding UpdatesText}" ToolTip="{Binding UpdatesToolTip}" FontSize="11" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UpdatesNeedAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ProtectionText}" FontSize="11" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ProtectionAtRisk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasBattery}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Battery" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                                <ProgressBar Grid.Column="1" Value="{Binding BatteryPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasProblems}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="Problems" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" ToolTip="Logged by Windows in the last 7 days. Details shows each one.">
                                                                <Run Text="Last 7 days: " /><Run Text="{Binding ProblemsText, Mode=OneWay}" />
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ProblemsSerious}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                            <TextBlock Text="{Binding BatteryDetail}" FontSize="11" TextWrapping="Wrap" Margin="44,1,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding BatteryWorn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNetworkActivity}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Net" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding NetworkText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding NetworkDetail}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="44,1,0,0" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Disks}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,4,0,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                            <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="44,1,0,0" />
                                                                        <TextBlock Text="{Binding ActivityText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="44,1,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasActivity}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding UpdateText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUpdateText}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                                                    <!-- Wraps to a second line on narrow tiles instead of clipping the first buttons. -->
                                                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,-6,0">
                                                        <Button Content="Update" Tag="{Binding}" Click="UpdateRemotePcButton_Click" Margin="0,6,6,0"
                                                                ToolTip="That PC downloads the latest official release, checks it and installs it silently.">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource HeaderMiniButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanUpdate}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Actions" Tag="{Binding}" Click="ActionsRemotePcButton_Click" Margin="0,6,6,0"
                                                                ToolTip="Message, restart or shut down, lock, clear temporary files or check for Windows updates on that PC.">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource HeaderMiniButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActionsAllowed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Details" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="DetailsRemotePcButton_Click" Margin="0,6,6,0"
                                                                ToolTip="What is using the PC now, who is signed in, last restart, and crashes and problems from the last 30 days." />
                                                        <Button Content="Speed test" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="SpeedTestRemotePcButton_Click" Margin="0,6,6,0"
                                                                ToolTip="Local network speed between this PC and that PC, and that PC's internet speed." />
                                                        <Button Content="Edit" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="EditRemotePcButton_Click" Margin="0,6,6,0" />
                                                        <Button Content="Remove" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="RemoveRemotePcButton_Click" Margin="0,6,6,0" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RemotePcsEmptyText" Text="No PCs added yet. Turn on sharing on the PCs you want to watch, then use Find PCs or Add PC." Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
            </Border>
        </Grid>

        <!-- Hidden legacy controls keep the existing device selection/detail logic source-compatible. -->
        <Grid Visibility="Collapsed">
            <TabControl x:Name="SidePanelTabs" />
            <TextBlock x:Name="NoSelectionText" />
            <StackPanel x:Name="DeviceDetailsPanel">
                <TextBlock x:Name="DetailNameText"/><TextBlock x:Name="DetailIpText"/><TextBlock x:Name="DetailStatusText"/><TextBlock x:Name="DetailHostnameText"/><TextBlock x:Name="DetailMacText"/><TextBlock x:Name="DetailResponseText"/><TextBlock x:Name="DetailLastCheckedText"/><TextBlock x:Name="DetailErrorText"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="DeviceEditorOverlay"
              Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed"
              Panel.ZIndex="100"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyDown="DeviceEditorOverlay_KeyDown">
            <Border Width="420"
                    MaxWidth="520"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22"
                    Effect="{StaticResource AppleCardShadow}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DeviceEditorTitleText" Text="Add device" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="Device name" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                    <TextBox x:Name="DeviceEditorNameTextBox" MaxLength="80" />
                    <TextBlock Text="IPv4 address" FontWeight="SemiBold" FontSize="11" Margin="0,14,0,6" />
                    <TextBox x:Name="DeviceEditorIpTextBox" MaxLength="15" ToolTip="Example: 192.168.1.50" />
                    <TextBlock x:Name="DeviceEditorValidationText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="20" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Tag="&#xE711;" Style="{StaticResource IconButton}" Width="92" Click="CancelDeviceEditorButton_Click" />
                        <Button Content="Save device" Tag="&#xE74E;" Width="112" Margin="8,0,0,0" Style="{StaticResource IconPrimaryButton}" Click="SaveDeviceEditorButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
