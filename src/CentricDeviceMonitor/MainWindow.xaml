                <!-- NETWORK CENTER -->
                <ScrollViewer x:Name="NetworkDiagnosticsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,32" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <TextBlock Text="NETWORK" Style="{StaticResource SectionEyebrowStyle}" />
                        <TextBlock Text="Network center" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Everything for this network in one place: watched devices and the IP scanner, the current connection, adapter settings, shared folders and NAS, and troubleshooting and repair tools."
                                   Style="{StaticResource SectionDescriptionStyle}" />

                        <!-- IP scanner, automatic monitoring and the managed IP addresses in one card. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="IP Scanner &amp; Monitoring" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="DeviceCountText" Text="0 device(s)" Style="{StaticResource InfoLabelStyle}" Margin="10,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Check all now" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshAllButton_Click" Margin="0,0,8,0" ToolTip="Immediately ping every saved managed device instead of waiting for the next interval." />
                                        <Button Content="Open IP scanner &amp; manage addresses" Tag="&#xE721;" Style="{StaticResource IconCompactPrimaryButton}" Click="OpenIpScannerButton_Click" Margin="0" ToolTip="Scan the local IPv4 subnet, add, edit or remove monitored IP addresses and check common TCP ports." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Discover devices on the local subnet, keep a list of managed IP addresses and check them automatically. Live availability comes from the dashboard or the LocalSystem monitoring service. Double-click a device to open its connection history."
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="AutomaticMonitoringCheckBox"
                                                  Content="Automatic ping monitoring"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  FontSize="11"
                                                  Checked="AutomaticMonitoringCheckBox_Changed"
                                                  Unchecked="AutomaticMonitoringCheckBox_Changed"
                                                  ToolTip="Enable background ping checks for saved managed devices and log outages/recoveries." />
                                    <TextBlock Grid.Column="2" Text="Interval" Style="{StaticResource InfoLabelStyle}" />
                                    <ComboBox Grid.Column="3" x:Name="PingIntervalComboBox" Margin="8,0,12,0" FontSize="11" SelectionChanged="PingIntervalComboBox_SelectionChanged" ToolTip="Choose how often saved managed devices are checked for reachability.">
                                        <ComboBoxItem Content="10 seconds" Tag="10"/><ComboBoxItem Content="15 seconds" Tag="15"/><ComboBoxItem Content="30 seconds" Tag="30"/>
                                        <ComboBoxItem Content="1 minute" Tag="60"/><ComboBoxItem Content="2 minutes" Tag="120"/><ComboBoxItem Content="5 minutes" Tag="300"/><ComboBoxItem Content="10 minutes" Tag="600"/><ComboBoxItem Content="30 minutes" Tag="1800"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="4" x:Name="PingCountdownText" Text="Next ping: --:--" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <DataGrid x:Name="DeviceGrid"
                                          ItemsSource="{Binding Devices}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          RowHeaderWidth="0"
                                          MinHeight="220"
                                          Margin="0,12,0,0"
                                          SelectionChanged="DeviceGrid_SelectionChanged"
                                          MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.1*" />
                                        <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="1*" />
                                        <DataGridTemplateColumn Header="Status" Width="112">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE9CE;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Offline"><Setter Property="Text" Value="&#xE711;" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Checking"><Setter Property="Text" Value="&#xE895;" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Offline"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Checking"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    </StackPanel>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Response" Binding="{Binding ResponseDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="1.25*" />
                                        <DataGridTextColumn Header="Last checked" Binding="{Binding LastCheckedDisplay}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Every active connection, plus the public address the internet sees. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE95E;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Current Connection" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshSystemHealthDetailsButton_Click" Margin="0" ToolTip="Refresh the active connections and the public connection details." />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Network" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" x:Name="NetworkStatusText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4"/>
                                        </Grid>
                                        <TextBlock x:Name="ActiveConnectionsHeaderText" Text="Active connections" Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,4"/>
                                        <ItemsControl x:Name="ActiveConnectionsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" ToolTip="{Binding Description}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Headline}" FontSize="12" FontWeight="SemiBold" />
                                                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsedForInternet}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Internet" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LinkDisplay}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding AddressDisplay}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ActiveConnectionsEmptyText" Text="Checking connections..." Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Public IP" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="PublicIpText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Text="IP location" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="PublicLocationText" Text="Checking IP location..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="2" Text="ISP / server" Style="{StaticResource InfoLabelStyle}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="PublicServerText" Text="Checking..." Style="{StaticResource InfoValueStyle}" Margin="0,4" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SystemHealthUpdatedText" Text="Extended details refresh automatically." Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Packet loss &amp; speed tests" Tag="&#xE721;" Style="{StaticResource IconCompactPrimaryButton}" Click="OpenNetworkSpeedTestButton_Click" Margin="0,0,8,0" ToolTip="Tests packet loss and jitter, shows local link bandwidth, opens FAST.com for internet speed, and measures actual PC-to-PC LAN throughput without internet." />
                                    <Button Grid.Column="2" Content="View system health log" Tag="&#xE81C;" Style="{StaticResource IconCompactButton}" Click="ViewSystemHealthLogButton_Click" Margin="0" ToolTip="Review saved system/network health samples and changes." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Adapter IPv4 / DNS configuration -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE839;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Network Adapter Settings (Administrator)" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Windows adapters" Tag="&#xE8A7;" Style="{StaticResource IconCompactButton}" Click="OpenWindowsNetworkConnectionsButton_Click" Margin="0,0,8,0" ToolTip="Open Windows Network Connections (ncpa.cpl) to enable, disable, rename or configure adapters." />
                                        <Button Content="Refresh" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="RefreshNetworkAdaptersButton_Click" Margin="0" ToolTip="Reload adapters and their current settings." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Choose an adapter, then switch between automatic (DHCP) and a static IP, and pick a DNS service. Changing these can briefly drop the connection, including RDP and VPN sessions."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Adapter" Style="{StaticResource InfoLabelStyle}" />
                                    <ComboBox Grid.Column="1" x:Name="NetworkAdapterComboBox" DisplayMemberPath="DisplayName" FontSize="11" SelectionChanged="NetworkAdapterComboBox_SelectionChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Current" Style="{StaticResource InfoLabelStyle}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" x:Name="NetworkAdapterCurrentText" Text="Select an adapter." Style="{StaticResource CardDescriptionStyle}" />
                                </Grid>
                                <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,4,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type / speed" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AdapterTypeSpeedText" Style="{StaticResource InfoValueStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="MAC address" Style="{StaticResource InfoLabelStyle}" Margin="12,3,0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="AdapterMacText" Style="{StaticResource InfoValueStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DHCP server" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AdapterDhcpServerText" Style="{StaticResource InfoValueStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Lease" Style="{StaticResource InfoLabelStyle}" Margin="12,3,0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="AdapterLeaseText" Style="{StaticResource InfoValueStyle}" Margin="0,3" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gateway ping" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AdapterGatewayPingText" Style="{StaticResource InfoValueStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Internet ping" Style="{StaticResource InfoLabelStyle}" Margin="12,3,0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="AdapterInternetPingText" Style="{StaticResource InfoValueStyle}" Margin="0,3" ToolTip="Ping to 1.1.1.1"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="IPv6" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="AdapterIpv6Text" Style="{StaticResource InfoValueStyle}" Margin="0,3" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="IP address" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <RadioButton x:Name="AdapterDhcpRadio" GroupName="AdapterIpMode" Content="Obtain an IP address automatically (DHCP)" FontSize="11" IsChecked="True" Checked="AdapterIpMode_Changed" Margin="0,0,0,4" />
                                        <RadioButton x:Name="AdapterStaticRadio" GroupName="AdapterIpMode" Content="Use a static IP address" FontSize="11" Checked="AdapterIpMode_Changed" Margin="0,0,0,8" />
                                        <Grid x:Name="AdapterStaticFields" IsEnabled="False">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="IP address" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="AdapterIpTextBox" FontSize="11" Margin="0,3" ToolTip="Example: 192.168.1.50"/>
                                            <TextBlock Grid.Row="1" Text="Subnet mask" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="AdapterMaskTextBox" FontSize="11" Margin="0,3" Text="255.255.255.0" ToolTip="Usually 255.255.255.0 on home and small office networks"/>
                                            <TextBlock Grid.Row="2" Text="Default gateway" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="AdapterGatewayTextBox" FontSize="11" Margin="0,3" ToolTip="Your router, for example 192.168.1.1. Leave empty for no gateway."/>
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Example: 192.168.1.50  •  255.255.255.0  •  192.168.1.1. Use an address outside the router's DHCP range."
                                                       Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DNS servers" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ComboBox x:Name="DnsPresetComboBox" FontSize="11" SelectionChanged="DnsPresetComboBox_SelectionChanged" Margin="0,0,0,4" />
                                        <TextBlock x:Name="DnsPresetNoteText" Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,8" />
                                        <Grid x:Name="DnsServerFields">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Preferred DNS" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrimaryDnsTextBox" FontSize="11" Margin="0,3" TextChanged="DnsTextBox_TextChanged" ToolTip="Pick a service above, or type any DNS server, for example 8.8.8.8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="PrimaryDnsPingText" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right" Margin="8,3,0,3"/>
                                            <TextBlock Grid.Row="1" Text="Alternate DNS" Style="{StaticResource InfoLabelStyle}" Margin="0,3"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SecondaryDnsTextBox" FontSize="11" Margin="0,3" TextChanged="DnsTextBox_TextChanged" ToolTip="Optional. Keep the service's alternate or type your own, for example 1.1.1.1"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SecondaryDnsPingText" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right" Margin="8,3,0,3"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- DNS response times: every preset plus the DNS servers currently in use. -->
                                <Grid Margin="0,16,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DNS response times" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DnsLatencyHintText" Text="Average of 3 pings to each server. Lower is faster." Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="TestDnsSpeedButton" Content="Test again" Tag="&#xE72C;" Style="{StaticResource IconCompactButton}" Click="TestDnsSpeedButton_Click" Margin="0" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl x:Name="DnsLatencyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Servers}" Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LatencyBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="Use" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Visibility="{Binding UseVisibility}" Click="UseDnsLatencyRow_Click" Margin="0" ToolTip="Fill the DNS fields with these servers" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="Reset to automatic" Tag="&#xE777;" Style="{StaticResource IconCompactButton}" Click="ResetAdapterToAutomaticButton_Click" Margin="0,0,8,0" ToolTip="Set this adapter back to DHCP with automatic DNS." />
                                    <Button x:Name="ApplyAdapterSettingsButton" Content="Apply settings" Tag="&#xE73E;" Style="{StaticResource IconCompactPrimaryButton}" Click="ApplyAdapterSettingsButton_Click" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shared folders: from this PC and on the local network. -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8F7;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Shared Folders" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Folders this PC shares, network folders and drives added to this PC (test, open or remove them), and shared folders on other PCs of the local network. Add to File Explorer puts a share under This PC > Network locations."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LocalSharesHeaderText" Text="Shared from this PC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource HeaderMiniButton}" Click="RefreshLocalSharesButton_Click" Margin="0" />
                                </Grid>
                                <ItemsControl x:Name="LocalSharesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UncPath}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open folder" Style="{StaticResource HeaderMiniButton}" Tag="{Binding Path}" Click="OpenShareButton_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="LocalSharesEmptyText" Text="Reading shared folders..." Style="{StaticResource CardDescriptionStyle}" />

                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AddedFoldersHeaderText" Text="Network folders added to this PC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="TestAllAddedFoldersButton" Content="Test all" Style="{StaticResource HeaderMiniButton}" Click="TestAllAddedFoldersButton_Click" Margin="0" />
                                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource HeaderMiniButton}" Click="RefreshAddedFoldersButton_Click" Margin="6,0,0,0" />
                                </Grid>
                                <ItemsControl x:Name="AddedFoldersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="NeedsSignIn"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open" Style="{StaticResource HeaderMiniButton}" Tag="{Binding OpenPath}" Click="OpenShareButton_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Test connection" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="TestAddedFolderButton_Click" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="Remove" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="RemoveAddedFolderButton_Click" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AddedFoldersEmptyText" Text="Reading network folders..." Style="{StaticResource CardDescriptionStyle}" />

                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NetworkSharesHeaderText" Text="Shared on the network (PCs and NAS)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="ScanNetworkSharesButton" Content="Scan network" Style="{StaticResource HeaderMiniButton}" Click="ScanNetworkSharesButton_Click" Margin="0" />
                                </Grid>
                                <ItemsControl x:Name="NetworkSharesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Web admin" Style="{StaticResource HeaderMiniButton}" Tag="{Binding AdminUrl}" Click="OpenNasAdminButton_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding AdminVisibility}" ToolTip="{Binding AdminUrl}" />
                                                <Button Grid.Column="2" Content="Open" Style="{StaticResource HeaderMiniButton}" Tag="{Binding UncPath}" Click="OpenShareButton_Click" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="Add to File Explorer" Style="{StaticResource HeaderMiniButton}" Tag="{Binding}" Click="AddShareToExplorerButton_Click" Margin="6,0,0,0" VerticalAlignment="Center" />
