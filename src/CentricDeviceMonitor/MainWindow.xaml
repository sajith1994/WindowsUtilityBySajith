<Window x:Class="CentricDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CentricDeviceMonitor.Controls"
        Title="Windows Utility by Sajith"
        Width="1220"
        Height="780"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect" Value="{StaticResource AppleCardShadow}" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,16" />
            <Setter Property="MinHeight" Value="126" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,4" />
        </Style>

        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeaderMiniButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- macOS-style navigation sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,0,8,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/app-logo.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Utility" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="by Sajith" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="TOOLS"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           Margin="12,0,0,5" />

                <ListBox x:Name="NavigationList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavigationList_SelectionChanged"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyphStyle}" />
                            <TextBlock Text="System Stats" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" />
                            <TextBlock Text="Network Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE772;" Style="{StaticResource IconGlyphStyle}" />
                            <TextBlock Text="Utility Tools" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE83F;" Style="{StaticResource IconGlyphStyle}" />
                            <TextBlock Text="Power &amp; Battery" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="3">
                    <Separator Margin="8,8,8,10" Background="{DynamicResource BorderBrush}" />
                    <Button x:Name="SidebarUpdateButton"
                            Content="Check for updates"
                            Tag="&#xE777;"
                            Style="{StaticResource IconButton}"
                            HorizontalContentAlignment="Left"
                            Click="CheckForUpdatesButton_Click"
                            Margin="0,0,0,6" />
                    <Button Content="About Windows Utility"
                            Tag="&#xEA1F;"
                            Style="{StaticResource IconButton}"
                            HorizontalContentAlignment="Left"
                            Click="AboutButton_Click"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main shell: translucent toolbar, content, status bar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="System Stats"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="Live health, hardware inventory and monitoring overview"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SecondarySurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SystemThemeRadio"
                                         Content="System"
                                         GroupName="ThemePreference"
                                         Tag="System"
                                         Style="{StaticResource SegmentedRadioButton}"
                                         Checked="ThemePreferenceRadio_Checked" />
                            <RadioButton x:Name="LightThemeRadio"
                                         Content="Light"
                                         GroupName="ThemePreference"
                                         Tag="Light"
                                         Style="{StaticResource SegmentedRadioButton}"
                                         Checked="ThemePreferenceRadio_Checked" />
                            <RadioButton x:Name="DarkThemeRadio"
                                         Content="Dark"
                                         GroupName="ThemePreference"
                                         Tag="Dark"
                                         Style="{StaticResource SegmentedRadioButton}"
                                         Checked="ThemePreferenceRadio_Checked" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="HeaderPrimaryActionButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Tag="&#xE72C;"
                            Style="{StaticResource IconPrimaryButton}"
                            Click="HeaderPrimaryActionButton_Click"
                            Margin="0"
                            MinWidth="104"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Update alert: shown on every start while an update is available, unless snoozed. -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerTitle" Text="An update is available" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UpdateBannerDetail" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Update now" Tag="&#xE896;" Style="{StaticResource IconCompactPrimaryButton}" Click="UpdateBannerUpdateButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="UpdateSnoozeButton" Content="Remind me later" Tag="&#xE823;" Style="{StaticResource IconCompactButton}" Click="UpdateSnoozeButton_Click" Margin="0">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remind me tomorrow" Tag="1" Click="UpdateSnoozeMenuItem_Click" />
                                    <MenuItem Header="Remind me in 3 days" Tag="3" Click="UpdateSnoozeMenuItem_Click" />
                                    <MenuItem Header="Remind me in a week" Tag="7" Click="UpdateSnoozeMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <!-- SYSTEM STATS -->
                <ScrollViewer x:Name="SystemStatsPage"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,32" MaxWidth="1180" HorizontalAlignment="Stretch">
                        <TextBlock Text="OVERVIEW" Style="{StaticResource SectionEyebrowStyle}" />
                        <TextBlock Text="System at a glance" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Live resource health, hardware inventory, sensors and background monitoring in one clean view."
                                   Style="{StaticResource SectionDescriptionStyle}" Margin="0,0,0,10" />

                        <!-- Layout toolbar: Customize turns on move/resize handles on every tile. -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DashboardLayoutHintText"
                                       Text="Right-click a tile to pin it to the desktop."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ResetDashboardLayoutButton" Content="Reset layout" Tag="&#xE777;" Style="{StaticResource IconCompactButton}" Click="ResetDashboardLayoutButton_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button x:Name="CustomizeDashboardButton" Content="Customize" Tag="&#xE70F;" Style="{StaticResource IconCompactButton}" Click="CustomizeDashboardButton_Click" Margin="0" />
                                <Button x:Name="DoneCustomizingDashboardButton" Content="Done" Tag="&#xE73E;" Style="{StaticResource IconCompactPrimaryButton}" Click="CustomizeDashboardButton_Click" MinWidth="90" Margin="0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <controls:DashboardPanel x:Name="DashboardTilesPanel">

                        <!-- Verdict-first summary. Everything below it is the supporting detail. -->
                        <controls:DashboardTile TileId="health" Title="Health summary" Span="4">
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,4,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="HealthStatusDot" Width="12" Height="12" CornerRadius="6"
                                            Background="#16A34A" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock x:Name="HealthOverallText" Text="Checking this PC..."
                                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="HealthSummaryText" Text="Reading sensors and storage."
                                           Style="{StaticResource CardDescriptionStyle}" Margin="21,2,0,8" TextWrapping="Wrap" />
                                <ItemsControl x:Name="HealthDomainList" Margin="21,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                                            VerticalAlignment="Center" Background="{Binding StatusBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Headline}" FontSize="12" Margin="14,1,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource CardDescriptionStyle}"
                                                           Margin="14,1,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </controls:DashboardTile>

                            <!-- One card per physical component. Click to open live graphs. -->
                            <controls:DashboardTile TileId="cpu" Title="Processor" Span="2">
                            <Border Style="{StaticResource MetricCardStyle}" Cursor="Hand"
                                    MouseLeftButtonUp="CpuCard_Click" ToolTip="Open live CPU graphs">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE957;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Processor" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.5"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="CpuTemperatureText" Text="Checking..." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,3" />
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Usage" Style="{StaticResource CardDescriptionStyle}" />
                                            <TextBlock x:Name="CpuUsageText" Text="--%" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Package power" Style="{StaticResource CardDescriptionStyle}" />
                                            <TextBlock x:Name="CpuPackagePowerText" Text="Checking..." FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="CpuUsageDetailText" Text="CPU model" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="CpuTemperatureDetailText" Text="Detecting sensor" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="CpuPackagePowerAverageText" Text="Average this session: -- W" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="CpuPackagePowerMaxText" Text="Max this session: -- W" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="CpuPackagePowerSensorText" Text="Detecting power sensor" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="CpuFanSpeedText" Text="CPU fan: Checking..." Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="CaseFanSpeedText" Text="Case fans: Checking..." Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                </StackPanel>
                            </Border>
                            </controls:DashboardTile>

                            <controls:DashboardTile TileId="gpu" Title="Graphics" Span="2">
                            <Border Style="{StaticResource MetricCardStyle}" Cursor="Hand"
                                    MouseLeftButtonUp="GpuCard_Click" ToolTip="Open live GPU graphs">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F8;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Graphics" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.5"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="GpuTemperatureText" Text="Temperature: Checking..." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,3" />
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Utilisation" Style="{StaticResource CardDescriptionStyle}" />
                                            <TextBlock x:Name="GpuUtilisationText" Text="Checking..." FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Power" Style="{StaticResource CardDescriptionStyle}" />
                                            <TextBlock x:Name="GpuPowerText" Text="Checking..." FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="GpuMemoryText" Text="VRAM: Checking..." Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="GpuPowerAverageText" Text="Average this session: -- W" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="GpuPowerMaxText" Text="Max this session: -- W" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="GpuFanSpeedText" Text="GPU fans: Checking..." Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="GpuPowerSensorText" Text="Detecting GPU power sensor" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                </StackPanel>
                            </Border>
                            </controls:DashboardTile>

                            <controls:DashboardTile TileId="memory" Title="Memory" Span="2">
                            <Border Style="{StaticResource MetricCardStyle}" Cursor="Hand"
                                    MouseLeftButtonUp="MemoryCard_Click" ToolTip="Open live memory graph">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F1;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Memory" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.5"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="RamUsageText" Text="--%" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,3" />
                                    <TextBlock x:Name="RamUsageDetailText" Text="RAM speed" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                    <TextBlock x:Name="RamModuleCountText" Text="Modules: checking..." Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            </controls:DashboardTile>

                            <controls:DashboardTile TileId="spooler" Title="Print Spooler &amp; printers" Span="2">
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Print Spooler" Style="{StaticResource InfoLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SpoolerStatusHeaderText" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" />
                                    <UniformGrid Columns="3">
                                        <Button Content="Start" Style="{StaticResource HeaderMiniButton}" Click="StartSpoolerButton_Click" />
                                        <Button Content="Stop" Style="{StaticResource HeaderMiniButton}" Click="StopSpoolerButton_Click" />
                                        <Button Content="Restart" Style="{StaticResource HeaderMiniButton}" Click="RestartSpoolerButton_Click" Margin="0" />
                                    </UniformGrid>

                                    <Grid Margin="0,14,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="InstalledPrintersHeaderText" Text="Installed printers" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Devices &amp; Printers" Style="{StaticResource HeaderMiniButton}" Click="OpenDevicesAndPrintersButton_Click" Margin="0" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="InstalledPrintersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,3">
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="InstalledPrintersEmptyText" Text="Reading installed printers..." Style="{StaticResource CardDescriptionStyle}" />

                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NetworkPrintersHeaderText" Text="Printers on the network" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button x:Name="ScanNetworkPrintersButton" Grid.Column="1" Content="Scan network" Style="{StaticResource HeaderMiniButton}" Click="ScanNetworkPrintersButton_Click" Margin="0" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="NetworkPrintersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
