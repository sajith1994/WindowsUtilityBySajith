<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>WindowsUtilityTray</AssemblyName>
    <RootNamespace>WindowsUtility.TrayHost</RootNamespace>
    <Authors>Sajith Varghese</Authors>
    <Product>Windows Utility Service Status</Product>
    <Description>Interactive notification-area companion that shows Windows Utility background service and monitoring health.</Description>
    <ApplicationIcon>..\WindowsUtility\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\WindowsUtility\Models\BackgroundServiceSnapshot.cs" Link="Models\BackgroundServiceSnapshot.cs" />
    <Compile Include="..\WindowsUtility\Models\RemoteMonitoring.cs" Link="Models\RemoteMonitoring.cs" />
    <Compile Include="..\WindowsUtility\Services\SharedDataPaths.cs" Link="Services\SharedDataPaths.cs" />
    <!-- The signed-in user's folder backups run here, as the user (no administrator rights). -->
    <Compile Include="..\WindowsUtility\Services\ApplicationLogService.cs" Link="Services\ApplicationLogService.cs" />
    <Compile Include="..\WindowsUtility\Models\BackupSchedule.cs" Link="Models\BackupSchedule.cs" />
    <Compile Include="..\WindowsUtility\Services\BackupScheduleStore.cs" Link="Services\BackupScheduleStore.cs" />
    <Compile Include="..\WindowsUtility\Services\FolderBackupRunner.cs" Link="Services\FolderBackupRunner.cs" />
    <Compile Include="..\WindowsUtility\Services\FolderBackupHistory.cs" Link="Services\FolderBackupHistory.cs" />
    <Compile Include="..\WindowsUtility\Services\FolderBackupScheduler.cs" Link="Services\FolderBackupScheduler.cs" />
  </ItemGroup>
</Project>
