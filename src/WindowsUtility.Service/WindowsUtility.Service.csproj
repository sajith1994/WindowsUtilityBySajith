<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>WindowsUtilityService</AssemblyName>
    <RootNamespace>WindowsUtility.ServiceHost</RootNamespace>
    <Authors>Sajith Varghese</Authors>
    <Product>Windows Utility Background Service</Product>
    <Description>LocalSystem background service for device, temperature, CPU, RAM, and network monitoring.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WindowsUtility.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre708" />
